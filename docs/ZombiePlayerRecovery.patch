+namespace TowerDefence.Networking.Integration
+{
+    [Preserve]
+    public sealed class PlayerBasicInfoRecoveryHandler : IReconnectRecoveryHandler
+    {
+        public string ModuleId => "player.basic-info";
+        public IEnumerable<RecoveryTask> CollectTasks(RecoveryContext context)
+        {
+            // Collection stays side-effect free; the registry executes this after game authentication.
+            yield return new RecoveryTask(RecoveryPhase.Refresh, (long)SessionSyncOrder.PlayerProfile,
+                "refresh-profile", token =>
+                {
+                    context.ThrowIfInvalid();
+                    return PlayerBasicInfoManager.Singleton.RecoverAsync(context);
+                });
+        }
+    }
+}
