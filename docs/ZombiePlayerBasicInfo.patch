+            updateFields = new[] { TowerDefence.Networking.Messages.PlayerProfileField.Avatar }, avatarId = 12 });
+        Check(updated.status == 1 && updated.avatarId == 12 && updated.guildId == 0 && updated.displayCharacterIds == "[0,0,0,0,0,0]", "real write codec and compatibility fields");
+        _panel.RefreshButton.onClick.Invoke(); await Until(() => _panel.RefreshButton.interactable);
+        Check(_panel.AvatarIdText.text == "12", "refresh reads persisted avatar");
+        Capture();
