+using System;
+using System.Threading;
+using TowerDefence.Networking.Integration;
+using UniFramework.Event;
+using UnityEngine;
+using UnityEngine.UI;
+namespace R.UI
+{
+    public sealed class UIPlayerBasicInfo : MonoBehaviour, IUIPanel
+    {
+        [Header("操作")]
+        public Button CloseButton;
+        public Button RefreshButton;
+        [Header("用户信息")]
+        public Text PlayerIdText, AccountIdText, NameText, AvatarIdText, CreateTimeText, StatusText;
+        private CancellationTokenSource _request;
+        private Guid _requestId;
+        private bool _loading;
+        public GameObject GameObject => gameObject;
+        private void Awake()
+        {
+            CloseButton.onClick.AddListener(Close);
+            RefreshButton.onClick.AddListener(Refresh);
+        }
+        private void OnEnable()
+        {
+            UniEvent.AddListener<PlayerBasicInfoLoadingEvent>(OnLoading);
+            UniEvent.AddListener<PlayerBasicInfoLoadedEvent>(OnLoaded);
+            UniEvent.AddListener<PlayerBasicInfoFailedEvent>(OnFailed);
+            UniEvent.AddListener<PlayerBasicInfoClearedEvent>(OnCleared);
+        }
+        private void OnDisable()
+        {
+            UniEvent.RemoveListener<PlayerBasicInfoLoadingEvent>(OnLoading);
+            UniEvent.RemoveListener<PlayerBasicInfoLoadedEvent>(OnLoaded);
+            UniEvent.RemoveListener<PlayerBasicInfoFailedEvent>(OnFailed);
+            UniEvent.RemoveListener<PlayerBasicInfoClearedEvent>(OnCleared);
+            CancelRequest();
+        }
+        private void OnDestroy()
+        {
+            CloseButton.onClick.RemoveListener(Close);
+            RefreshButton.onClick.RemoveListener(Refresh);
+            CancelRequest();
+        }
+        public void OnSHow() { if (!_loading) { ClearDisplay(); Refresh(); } }
+        private void Refresh()
+        {
+            if (_loading) return;
+            CancelRequest();
+            _request = new CancellationTokenSource(); _requestId = Guid.NewGuid();
+            SetLoading(true, "正在获取用户信息…");
+            UniEvent.SendMessage(new PlayerBasicInfoRequestedEvent(_requestId, _request.Token));
+        }
+        private void OnLoading(IEventMessage message)
+        { if (((PlayerBasicInfoLoadingEvent)message).RequestId == _requestId) SetLoading(true, "正在获取用户信息…"); }
+        private void OnLoaded(IEventMessage message)
+        {
+            var result = (PlayerBasicInfoLoadedEvent)message;
+            if (result.RequestId != _requestId) return;
+            var info = result.Info;
+            PlayerIdText.text = info.PlayerId.ToString(); AccountIdText.text = info.AccountId.ToString();
+            NameText.text = string.IsNullOrEmpty(info.Name) ? "未命名" : info.Name; AvatarIdText.text = info.AvatarId.ToString();
+            CreateTimeText.text = FormatTime(info.CreateTime);
+            SetLoading(false, "已更新");
+        }
+        public static string FormatTime(long unixSeconds)
+        {
+            if (unixSeconds <= 0) return "未知";
+            try { return DateTimeOffset.FromUnixTimeSeconds(unixSeconds).LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss"); }
+            catch (ArgumentOutOfRangeException) { return "未知"; }
+        }
+        private void OnFailed(IEventMessage message)
+        { var result = (PlayerBasicInfoFailedEvent)message; if (result.RequestId == _requestId) SetLoading(false, result.Error); }
+        private void OnCleared(IEventMessage message)
+        {
+            var result = (PlayerBasicInfoClearedEvent)message;
+            if (result.RequestId != Guid.Empty && result.RequestId != _requestId) return;
+            CancelRequest(); ClearDisplay(); SetLoading(false, "会话已变化，请连接游戏服后刷新。");
+        }
+        private void ClearDisplay()
+        { PlayerIdText.text = AccountIdText.text = NameText.text = AvatarIdText.text = CreateTimeText.text = "—"; }
+        private void SetLoading(bool loading, string status)
+        { _loading = loading; RefreshButton.interactable = !loading; StatusText.text = status; }
+        private void CancelRequest()
+        { _requestId = Guid.Empty; _request?.Cancel(); _request?.Dispose(); _request = null; _loading = false; }
+        private void Close() => UIMgr.Singleton.ConcealUI(nameof(UIPlayerBasicInfo));
+    }
+}
