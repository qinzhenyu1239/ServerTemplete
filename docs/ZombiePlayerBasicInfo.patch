+using System;
+using System.Threading;
+using Cysharp.Threading.Tasks;
+using TowerDefence.Networking.Messages;
+using UniFramework.Event;
+using UnityEngine;
+namespace TowerDefence.Networking.Integration
+{
+    public sealed class PlayerBasicInfoManager : Singleton_Mono<PlayerBasicInfoManager>
+    {
+        private bool _initialized, _disposed;
+        private long _generation;
+        private CancellationTokenSource _operation;
+        public PlayerBasicInfoModel CurrentInfo { get; private set; }
+        public bool IsBusy => _operation != null;
+        protected override bool Can_AutoInstance() => true;
+        protected override void OnInit()
+        {
+            if (_initialized) return;
+            _initialized = true;
+            DontDestroyOnLoad(gameObject);
+            UniEvent.AddListener<PlayerBasicInfoRequestedEvent>(OnRequested);
+            UniEvent.AddListener<UserLogoutStartedEvent>(OnSessionChanged);
+            UniEvent.AddListener<UserLoginSucceededEvent>(OnSessionChanged);
+            UniEvent.AddListener<NetworkDisconnectedEvent>(OnSessionChanged);
+            UniEvent.AddListener<NetworkConnectingEvent>(OnSessionChanged);
+            UniEvent.AddListener<NetworkRecoveryStartedEvent>(OnSessionChanged);
+        }
+        private void OnRequested(IEventMessage message)
+        {
+            var request = (PlayerBasicInfoRequestedEvent)message;
+            if (_disposed || request.RequestId == Guid.Empty || request.Cancellation.IsCancellationRequested) return;
+            if (IsBusy) { Fail(request.RequestId, "正在查询，请稍后重试。"); return; }
+            QueryAsync(request).Forget();
+        }
+        private async UniTaskVoid QueryAsync(PlayerBasicInfoRequestedEvent request)
+        {
+            CancellationTokenSource scope = null;
+            try
+            {
+                var login = LoginManager.Singleton;
+                var network = SessionNetwork.Singleton;
+                if (!login.IsLoggedIn || !network.IsGameAuthenticated) { Fail(request.RequestId, "请先登录并连接游戏服。"); return; }
+                long accountId = login.CurrentAccountId, connection = network.ConnectionGeneration, generation = _generation;
+                scope = CancellationTokenSource.CreateLinkedTokenSource(request.Cancellation, login.SessionCancellation, network.ConnectionCancellation);
+                _operation = scope;
+                UniEvent.SendMessage(new PlayerBasicInfoLoadingEvent(request.RequestId));
+                var response = await PlayerBasicInfoNetwork.QueryAsync(scope.Token);
+                scope.Token.ThrowIfCancellationRequested();
+                if (_disposed || generation != _generation || accountId != login.CurrentAccountId || connection != network.ConnectionGeneration || !network.IsGameAuthenticated) return;
+                if (response == null || response.status != (int)Respones.OK || response.playerId <= 0)
+                    throw new InvalidOperationException(response?.errorMessage ?? "查询用户信息失败。");
+                CurrentInfo = new PlayerBasicInfoModel(response.playerId, accountId, response.name, response.avatarId, response.createTime);
+                UniEvent.SendMessage(new PlayerBasicInfoLoadedEvent(request.RequestId, CurrentInfo));
+            }
+            catch (OperationCanceledException)
+            {
+                if (!_disposed && !request.Cancellation.IsCancellationRequested && ReferenceEquals(_operation, scope)) Fail(request.RequestId, "连接已变化，请重新查询。");
+            }
+            catch (Exception error)
+            {
+                if (!_disposed && !request.Cancellation.IsCancellationRequested && (scope == null || ReferenceEquals(_operation, scope))) Fail(request.RequestId, error.Message);
+            }
+            finally
+            {
+                if (ReferenceEquals(_operation, scope)) _operation = null;
+                scope?.Dispose();
+            }
+        }
+        private static void Fail(Guid id, string error) => UniEvent.SendMessage(new PlayerBasicInfoFailedEvent(id, error));
+        private void OnSessionChanged(IEventMessage message)
+        {
+            _generation++; CurrentInfo = null;
+            var operation = _operation; _operation = null; operation?.Cancel();
+            UniEvent.SendMessage(new PlayerBasicInfoClearedEvent(Guid.Empty));
+        }
+        protected override void OnDestroy()
+        {
+            _disposed = true;
+            if (_initialized)
+            {
+                UniEvent.RemoveListener<PlayerBasicInfoRequestedEvent>(OnRequested);
+                UniEvent.RemoveListener<UserLogoutStartedEvent>(OnSessionChanged);
+                UniEvent.RemoveListener<UserLoginSucceededEvent>(OnSessionChanged);
+                UniEvent.RemoveListener<NetworkDisconnectedEvent>(OnSessionChanged);
+                UniEvent.RemoveListener<NetworkConnectingEvent>(OnSessionChanged);
+                UniEvent.RemoveListener<NetworkRecoveryStartedEvent>(OnSessionChanged);
+            }
+            OnSessionChanged(null);
+            base.OnDestroy();
+        }
+    }
+}
