+        EditorApplication.playModeStateChanged += state => {
+            if (state == PlayModeStateChange.EnteredPlayMode && SessionState.GetBool(Key, false))
+                EditorApplication.delayCall += Start;
+        };
+    }
+    public static void Run() { SessionState.SetBool(Key, true); EditorApplication.EnterPlaymode(); }
+    private static void Start() { _deadline = DateTime.UtcNow.AddSeconds(100); _task = VerifyAsync(); EditorApplication.update += Tick; }
+    private static void Tick()
+    {
+        if (!_task.IsCompleted && DateTime.UtcNow < _deadline) return;
+        int exit = 0;
+        try { Check(_task.IsCompleted, "smoke deadline"); _task.GetAwaiter().GetResult(); Debug.Log("PLAYER_BASIC_INFO_PASS: real database query and avatar update; event request/result correlation; repeat click; panel cancellation; disconnect; logout; login again; delayed response; 10-second timeout; references and screenshot"); }
+        catch (Exception error) { Debug.LogException(error); exit = 1; }
+        SessionState.SetBool(Key, false); EditorApplication.update -= Tick; EditorApplication.Exit(exit);
+    }
+    private static async Task VerifyAsync()
+    {
+        UniEvent.Initalize();
+        Configure("http://127.0.0.1:16091", "http://127.0.0.1:16090/PullingServerZone");
+        var network = SessionNetwork.Singleton; var login = LoginManager.Singleton;
+        PlayerBasicInfoManager.Singleton.Init(); // Initialization must not duplicate subscriptions.
+        CreatePanel();
+        _panel.OnSHow(); Check(_panel.RefreshButton.interactable && _panel.StatusText.text.Contains("登录"), "unauthenticated query restores refresh");
+        string username = "zprofile_" + DateTime.UtcNow.ToString("MMddHHmmss") + Guid.NewGuid().ToString("N").Substring(0, 5);
+        File.WriteAllText("profile-test-account.txt", username);
+        await login.RegisterAsync(username, "ProfileTest_123", "ProfileTest_123");
+        Check((await login.LoginAsync(username, "ProfileTest_123")).Success, "real account login");
+        await ConnectReal();
+        _panel.OnSHow(); _panel.RefreshButton.onClick.Invoke();
+        Guid duplicate = Guid.NewGuid(); bool duplicateRejected = false;
+        Action<IEventMessage> failed = message => { if (((PlayerBasicInfoFailedEvent)message).RequestId == duplicate) duplicateRejected = true; };
+        UniEvent.AddListener<PlayerBasicInfoFailedEvent>(failed);
+        UniEvent.SendMessage(new PlayerBasicInfoRequestedEvent(duplicate, CancellationToken.None));
+        Check(duplicateRejected, "manager rejects second in-flight request"); UniEvent.RemoveListener<PlayerBasicInfoFailedEvent>(failed);
