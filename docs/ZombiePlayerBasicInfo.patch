+        await ConnectReal(); _panel.OnSHow(); await Until(() => _panel.RefreshButton.interactable && PlayerBasicInfoManager.Singleton.CurrentInfo != null);
+        await login.LogoutAsync(); Check(PlayerBasicInfoManager.Singleton.CurrentInfo == null && _panel.AccountIdText.text == "—", "logout clears");
+        Check((await login.LoginAsync(username, "ProfileTest_123")).Success, "login again"); await ConnectReal();
