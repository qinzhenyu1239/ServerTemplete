+using System;
+using System.IO;
+using System.Linq;
+using R.UI;
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+using UnityEngine.UI;
+
+namespace TowerDefence.EditorTools
+{
+    public static class PlayerBasicInfoPrefabBuilder
+    {
+        private const string PrefabPath = "Assets/Prefabs/UI/Panel/PlayerBasicInfo/UIPlayerBasicInfo.prefab";
+        private const string ScenePath = "Assets/Scenes/Start.unity";
+        [MenuItem("Tools/TowerDefence/Build Player Basic Info UI")]
+        public static void Build()
+        {
+            Font font = AssetDatabase.LoadAssetAtPath<Font>("Assets/typeface/荆南缘默体.ttf");
+            if (font == null) throw new InvalidOperationException("Missing Chinese font.");
+            BuildPrefab(font);
+            var scene = SceneManager.GetSceneByPath(ScenePath);
+            bool opened = !scene.IsValid() || !scene.isLoaded;
+            if (opened) scene = EditorSceneManager.OpenScene(ScenePath, OpenSceneMode.Additive);
+            try
+            {
+                if (scene.isDirty) throw new InvalidOperationException("Start scene has unsaved edits; save it before building this button.");
+                var main = scene.GetRootGameObjects().SelectMany(x => x.GetComponentsInChildren<MainInterface>(true)).Single();
+                if (main.PlayerBasicInfoButton == null)
+                {
+                    var setting = main.SettingBtn.GetComponent<RectTransform>();
+                    var button = Button("PlayerBasicInfoButton", setting.parent, "用户信息", font, Vector2.zero);
+                    var rect = button.GetComponent<RectTransform>();
+                    rect.anchorMin = setting.anchorMin; rect.anchorMax = setting.anchorMax; rect.pivot = setting.pivot;
+                    rect.anchoredPosition = setting.anchoredPosition + new Vector2(0, -110);
+                    rect.sizeDelta = new Vector2(160, 64);
+                    main.PlayerBasicInfoButton = button;
+                    EditorUtility.SetDirty(main); EditorSceneManager.MarkSceneDirty(scene);
+                    if (!EditorSceneManager.SaveScene(scene)) throw new InvalidOperationException("Could not save Start scene.");
+                }
+                if (main.PlayerBasicInfoButton == null) throw new InvalidOperationException("MainInterface button was not bound.");
+            }
+            finally { if (opened) EditorSceneManager.CloseScene(scene, true); }
+            AssetDatabase.SaveAssets();
+            var prefab = AssetDatabase.LoadAssetAtPath<GameObject>(PrefabPath).GetComponent<UIPlayerBasicInfo>();
