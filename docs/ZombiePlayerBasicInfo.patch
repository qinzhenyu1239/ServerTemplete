+[InitializeOnLoad]
+public static class PlayerBasicInfoSmoke
+{
+    private const string Key = "TowerDefence.PlayerBasicInfoSmoke";
+    private static Task _task;
+    private static DateTime _deadline;
+    private static UIPlayerBasicInfo _panel;
+    private static GameObject _canvas;
