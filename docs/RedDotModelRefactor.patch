+using System;
+using System.Collections.Generic;
+using System.Collections.ObjectModel;
+using System.Linq;
+
+namespace MiaoWu.Networking.RedDot
+{
+    /// <summary>Configuration is received from the server. UI never owns parent relationships.</summary>
+    public sealed class RedDotTreeManager
+    {
+        private Dictionary<int, RedDotNodeModel> nodes = new();
+        private Dictionary<int, bool> states = new();
+        private readonly Dictionary<int, bool> enabled = new();
+        public RedDotTreeModel State { get; } = new();
+        public bool HasSnapshot => State.HasSnapshot;
+        public string ConfigVersion => State.ConfigVersion;
+        public long StateVersion => State.StateVersion;
+        public event Action Changed;
+
+        public bool IsActive(int nodeId) => HasSnapshot && states.TryGetValue(nodeId, out var value) && value;
+        public RedDotNodeModel GetNode(int nodeId) => nodes.TryGetValue(nodeId, out var n)
+            ? Copy(n) : null;
+
+        public void Reset()
+        {
+            nodes.Clear(); states.Clear(); enabled.Clear(); State.HasSnapshot = false;
+            State.ConfigVersion = null; State.StateVersion = 0;
+            Changed?.Invoke();
+        }
+
+        public void Replace(string configVersion, long stateVersion, IEnumerable<RedDotNodeModel> configuration,
+            IReadOnlyDictionary<int, bool> leaves)
+        {
+            if (string.IsNullOrEmpty(configVersion) || stateVersion < 0) throw new ArgumentException("Invalid red-dot snapshot.");
+            var map = new Dictionary<int, RedDotNodeModel>();
+            foreach (var n in configuration)
+            {
+                if (n.Id <= 0 || n.ClearType < 0 || n.ClearType > 2 || map.ContainsKey(n.Id))
+                    throw new ArgumentException("Invalid red-dot configuration.");
+                map.Add(n.Id, Copy(n));
+            }
+            var activeNodes = new Dictionary<int, bool>();
+            foreach (var n in map.Values)
+            {
+                var path = new HashSet<int> { n.Id };
+                var current = n;
+                bool active = n.Enabled;
+                while (current.ParentId != 0)
+                {
+                    if (!map.TryGetValue(current.ParentId, out current) || !path.Add(current.Id) || current.ClearType != 0)
+                        throw new ArgumentException("Missing parent, non-aggregate parent, or cycle.");
+                    active &= current.Enabled;
+                }
+                activeNodes[n.Id] = active;
+            }
+            // Validate before replacing any previous state.
+            nodes = map; enabled.Clear();
+            foreach (var pair in activeNodes) enabled.Add(pair.Key, pair.Value);
+            states = map.Keys.ToDictionary(id => id, _ => false);
+            ApplyLeaves(leaves, true);
+            State.Nodes = new ReadOnlyDictionary<int, RedDotNodeModel>(nodes);
+            State.States = new ReadOnlyDictionary<int, bool>(states);
+            State.EnabledNodes = new ReadOnlyDictionary<int, bool>(enabled);
+            State.ConfigVersion = configVersion; State.StateVersion = stateVersion; State.HasSnapshot = true;
+            Changed?.Invoke();
+        }
+
+        public bool ApplyDelta(string configVersion, long version, IReadOnlyDictionary<int, bool> changes)
+        {
+            if (!HasSnapshot || configVersion != ConfigVersion) return false;
+            if (version <= StateVersion) return true;
+            if (version != StateVersion + 1 || changes.Keys.Any(id =>
+                !nodes.TryGetValue(id, out var n) || n.ClearType == 0 || !enabled[id])) return false;
+            ApplyLeaves(changes, false); State.StateVersion = version; Changed?.Invoke(); return true;
+        }
+
+        public bool ApplyFullState(string configVersion, long version, IReadOnlyDictionary<int, bool> leaves)
+        {
+            if (!HasSnapshot || configVersion != ConfigVersion) return false;
+            if (version < StateVersion) return true;
+            ApplyLeaves(leaves, true); State.StateVersion = version; Changed?.Invoke(); return true;
+        }
+
+        private void ApplyLeaves(IReadOnlyDictionary<int, bool> leaves, bool replace)
+        {
+            if (replace)
+                foreach (var n in nodes.Values.Where(n => n.ClearType != 0)) states[n.Id] = false;
+            foreach (var pair in leaves)
+                if (nodes.TryGetValue(pair.Key, out var n) && n.ClearType != 0 && enabled[pair.Key])
+                    states[pair.Key] = pair.Value;
+            foreach (var n in nodes.Values.Where(n => n.ClearType == 0)) states[n.Id] = false;
+            foreach (var n in nodes.Values.Where(n => n.ClearType != 0 && states[n.Id]))
+            {
+                int parent = n.ParentId;
+                while (parent != 0) { states[parent] = true; parent = nodes[parent].ParentId; }
+            }
+        }
+        private static RedDotNodeModel Copy(RedDotNodeModel n) => new()
+        { Id = n.Id, Name = n.Name, ParentId = n.ParentId, ClearType = n.ClearType,
+            Enabled = n.Enabled, TipVersion = n.TipVersion };
+    }
+}
