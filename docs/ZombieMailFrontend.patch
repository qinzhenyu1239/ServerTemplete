+using UnityEngine;
+using UnityEngine.UI;
+namespace TowerDefence.EditorTools
+{
+    public static class MailPrefabBuilder
+    {
+        private static Font _font;
+        private static readonly Color Card = new Color(.09f,.14f,.20f), Accent = new Color(.16f,.38f,.48f);
+        [MenuItem("Tools/TowerDefence/Build Mail UI Prefab")]
+        public static void Build()
+        {
+            _font = AssetDatabase.LoadAssetAtPath<Font>("Assets/typeface/荆南缘默体.ttf");
+            if (_font == null) throw new InvalidOperationException("Missing Chinese font.");
+            var root = Node("UIMail", null, Vector2.zero, Vector2.zero); root.SetActive(false); Stretch(root.GetComponent<RectTransform>());
+            try
+            {
+                root.AddComponent<Image>().color = new Color(.025f,.04f,.07f,.95f);
+                var card = Node("Card", root.transform, new Vector2(940,1740), Vector2.zero); card.AddComponent<Image>().color = Card;
+                Label("Heading", card.transform, "邮件", 44, new Vector2(0,790), new Vector2(840,70));
+                var summary = Label("Summary", card.transform, "邮件 — / —    未读 —", 25, new Vector2(0,720), new Vector2(840,55));
+                var list = Scroll("MailList", card.transform, new Vector2(840,500), new Vector2(0,410), out var listContent);
+                var layout = listContent.gameObject.AddComponent<VerticalLayoutGroup>(); layout.spacing = 8; layout.padding = new RectOffset(10,10,10,10); layout.childControlWidth = true; layout.childControlHeight = true; layout.childForceExpandHeight = false;
+                var fitter = listContent.gameObject.AddComponent<ContentSizeFitter>(); fitter.verticalFit = ContentSizeFitter.FitMode.PreferredSize;
+                var rowButton = Button("MailRowTemplate", listContent, "邮件标题", Vector2.zero, new Vector2(820,88));
+                var size = rowButton.gameObject.AddComponent<LayoutElement>(); size.preferredHeight = 88; size.minHeight = 88;
+                var row = rowButton.gameObject.AddComponent<UIMailRow>(); row.SelectButton = rowButton; row.Label = rowButton.GetComponentInChildren<Text>(); row.Label.fontSize = 23; row.Label.alignment = TextAnchor.MiddleLeft;
+                row.gameObject.SetActive(false);
+                var empty = Label("Empty", list.viewport, "暂无邮件", 30, Vector2.zero, new Vector2(780,100)); empty.alignment = TextAnchor.MiddleCenter;
+                var detailTitle = Label("DetailTitle", card.transform, "请选择一封邮件", 28, new Vector2(0,105), new Vector2(840,70));
+                var bodyScroll = Scroll("Detail", card.transform, new Vector2(840,410), new Vector2(0,-155), out var bodyContent);
+                var body = bodyContent.gameObject.AddComponent<Text>(); body.font = _font; body.fontSize = 25; body.color = Color.white; body.supportRichText = false; body.alignment = TextAnchor.UpperLeft;
+                body.horizontalOverflow = HorizontalWrapMode.Wrap; body.verticalOverflow = VerticalWrapMode.Overflow; body.raycastTarget = false;
+                var bodyFitter = bodyContent.gameObject.AddComponent<ContentSizeFitter>(); bodyFitter.verticalFit = ContentSizeFitter.FitMode.PreferredSize;
+                var status = Label("Status", card.transform, "打开后自动获取邮件", 24, new Vector2(0,-425), new Vector2(840,90)); status.alignment = TextAnchor.MiddleCenter;
+                var claim = Button("Claim", card.transform, "领取附件", new Vector2(-215,-540), new Vector2(400,76));
+                var delete = Button("Delete", card.transform, "删除邮件", new Vector2(215,-540), new Vector2(400,76));
+                var claimAll = Button("ClaimAll", card.transform, "一键领取", new Vector2(-215,-645), new Vector2(400,76));
+                var deleteRead = Button("DeleteRead", card.transform, "删除已读", new Vector2(215,-645), new Vector2(400,76));
+                var refresh = Button("Refresh", card.transform, "刷新", new Vector2(-215,-750), new Vector2(400,76));
+                var close = Button("Close", card.transform, "关闭", new Vector2(215,-750), new Vector2(400,76));
+                var confirm = Node("Confirmation", root.transform, Vector2.zero, Vector2.zero); Stretch(confirm.GetComponent<RectTransform>()); confirm.AddComponent<Image>().color = new Color(0,0,0,.8f);
+                var confirmCard = Node("Dialog", confirm.transform, new Vector2(820,360), Vector2.zero); confirmCard.AddComponent<Image>().color = Card;
+                var confirmText = Label("Question", confirmCard.transform, "确认操作？", 28, new Vector2(0,60), new Vector2(740,160)); confirmText.alignment = TextAnchor.MiddleCenter;
+                var yes = Button("Confirm", confirmCard.transform, "确认", new Vector2(-190,-100), new Vector2(310,75));
+                var no = Button("Cancel", confirmCard.transform, "取消", new Vector2(190,-100), new Vector2(310,75)); confirm.SetActive(false);
+                var ui = root.AddComponent<UIMail>(); ui.CloseButton = close; ui.RefreshButton = refresh; ui.ClaimButton = claim; ui.ClaimAllButton = claimAll; ui.DeleteButton = delete; ui.DeleteReadButton = deleteRead;
+                ui.MailContent = listContent; ui.RowTemplate = row; ui.SummaryText = summary; ui.EmptyText = empty; ui.DetailTitleText = detailTitle; ui.BodyText = body; ui.BodyContent = bodyContent; ui.StatusText = status;
+                ui.ConfirmPanel = confirm; ui.ConfirmText = confirmText; ui.ConfirmButton = yes; ui.CancelButton = no;
+                root.SetActive(true); Directory.CreateDirectory("Assets/Prefabs/UI/Panel/Mail");
+                PrefabUtility.SaveAsPrefabAsset(root, "Assets/Prefabs/UI/Panel/Mail/UIMail.prefab");
+                Validate(ui);
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); }
+            AssetDatabase.SaveAssets(); Debug.Log("MAIL_PREFAB_BUILT");
+        }
+        public static void BuildAndExit()
+        {
+            try
+            {
+                Build();
+                var button = Button("MailButton", null, "邮件", Vector2.zero, new Vector2(160,64));
+                button.GetComponentInChildren<Text>().fontSize = 22;
+                var badge = button.gameObject.AddComponent<UIMailUnreadBadge>(); badge.Label = button.GetComponentInChildren<Text>();
+                PrefabUtility.SaveAsPrefabAsset(button.gameObject, "Assets/MailButton.prefab"); UnityEngine.Object.DestroyImmediate(button.gameObject);
+                EditorApplication.Exit(0);
+            }
+            catch (Exception error) { Debug.LogException(error); EditorApplication.Exit(1); }
+        }
+        public static void Validate(UIMail ui)
+        {
+            if (ui.CloseButton == null || ui.RefreshButton == null || ui.ClaimButton == null || ui.ClaimAllButton == null || ui.DeleteButton == null || ui.DeleteReadButton == null || ui.RowTemplate == null || ui.MailContent == null || ui.SummaryText == null || ui.EmptyText == null || ui.DetailTitleText == null || ui.BodyText == null || ui.BodyContent == null || ui.StatusText == null || ui.ConfirmPanel == null || ui.ConfirmText == null || ui.ConfirmButton == null || ui.CancelButton == null)
+                throw new InvalidOperationException("Mail UI reference missing.");
+        }
+        private static ScrollRect Scroll(string name, Transform parent, Vector2 size, Vector2 position, out RectTransform content)
+        {
+            var root = Node(name, parent, size, position); root.AddComponent<Image>().color = new Color(.055f,.09f,.14f);
+            var viewport = Node("Viewport", root.transform, Vector2.zero, Vector2.zero); Stretch(viewport.GetComponent<RectTransform>()); viewport.AddComponent<RectMask2D>();
+            var node = Node("Content", viewport.transform, new Vector2(0,0), Vector2.zero); content = node.GetComponent<RectTransform>(); content.anchorMin = new Vector2(0,1); content.anchorMax = new Vector2(1,1); content.pivot = new Vector2(.5f,1); content.sizeDelta = Vector2.zero;
+            var scroll = root.AddComponent<ScrollRect>(); scroll.horizontal = false; scroll.vertical = true; scroll.movementType = ScrollRect.MovementType.Clamped;
+            scroll.viewport = viewport.GetComponent<RectTransform>(); scroll.content = content; scroll.scrollSensitivity = 35; return scroll;
+        }
+        private static GameObject Node(string name, Transform parent, Vector2 size, Vector2 position)
+        {
+            var node = new GameObject(name, typeof(RectTransform)); node.layer = 5; node.transform.SetParent(parent,false);
+            var rect = node.GetComponent<RectTransform>(); rect.anchorMin = rect.anchorMax = rect.pivot = new Vector2(.5f,.5f); rect.sizeDelta = size; rect.anchoredPosition = position; return node;
+        }
+        private static void Stretch(RectTransform rect) { rect.anchorMin = Vector2.zero; rect.anchorMax = Vector2.one; rect.offsetMin = rect.offsetMax = Vector2.zero; }
+        private static Text Label(string name, Transform parent, string text, int size, Vector2 position, Vector2 dimensions)
+        {
+            var node = Node(name,parent,dimensions,position); var label = node.AddComponent<Text>(); label.font = _font; label.fontSize = size; label.color = Color.white; label.text = text;
+            label.alignment = TextAnchor.MiddleLeft; label.raycastTarget = false; label.supportRichText = false; return label;
+        }
+        private static Button Button(string name, Transform parent, string text, Vector2 position, Vector2 dimensions)
+        {
+            var node = Node(name,parent,dimensions,position); var image = node.AddComponent<Image>(); image.color = Accent;
+            var button = node.AddComponent<Button>(); button.targetGraphic = image;
+            var label = Label("Label",node.transform,text,28,Vector2.zero,Vector2.zero); Stretch(label.rectTransform); label.rectTransform.offsetMin = new Vector2(12,4); label.rectTransform.offsetMax = new Vector2(-12,-4); label.alignment = TextAnchor.MiddleCenter; return button;
+        }
+    }
+}
