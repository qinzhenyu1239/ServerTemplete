+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using Cysharp.Threading.Tasks;
+using TowerDefence.Networking.Messages;
+namespace TowerDefence.Networking.Integration
+{
+    public static class MailNetwork
+    {
+        private static NetworkRequestOptions Options(string key) => new NetworkRequestOptions
+        { Timeout = TimeSpan.FromSeconds(15), OperationKey = "mail." + key, DuplicatePolicy = DuplicateRequestPolicy.RejectNew };
+        public static async UniTask<MailResponseModel> SummaryAsync(CancellationToken token)
+        {
+            var response = await SessionNetwork.Singleton.RequestAsync<ResMailSummary>(new ReqMailSummary(), Options("Summary"), token);
+            if (response == null) throw new InvalidOperationException("邮件响应为空。");
+            return Map(response.status, response.errorMessage, response.mailboxVersion, response.serverTime, response.count, response.unreadCount, response.capacity, response.items, response.detail, response.itemQuantities, response.hasMore, response.nextOffset);
+        }
+        public static async UniTask<MailResponseModel> ListAsync(int offset, CancellationToken token)
+        {
+            var response = await SessionNetwork.Singleton.RequestAsync<ResMailList>(new ReqMailList { offset = offset, pageSize = 50 }, Options("List"), token);
+            if (response == null) throw new InvalidOperationException("邮件响应为空。");
+            return Map(response.status, response.errorMessage, response.mailboxVersion, response.serverTime, response.count, response.unreadCount, response.capacity, response.items, response.detail, response.itemQuantities, response.hasMore, response.nextOffset);
+        }
+        public static async UniTask<MailResponseModel> ReadAsync(long id, CancellationToken token)
+        {
+            var response = await SessionNetwork.Singleton.RequestAsync<ResMailRead>(new ReqMailRead { mailId = id }, Options("Read"), token);
+            if (response == null) throw new InvalidOperationException("邮件响应为空。");
+            return Map(response.status, response.errorMessage, response.mailboxVersion, response.serverTime, response.count, response.unreadCount, response.capacity, response.items, response.detail, response.itemQuantities, response.hasMore, response.nextOffset);
+        }
+        public static async UniTask<MailResponseModel> ClaimAsync(long id, CancellationToken token)
+        {
+            var response = await SessionNetwork.Singleton.RequestAsync<ResMailClaim>(new ReqMailClaim { mailId = id }, Options("Claim"), token);
+            if (response == null) throw new InvalidOperationException("邮件响应为空。");
+            return Map(response.status, response.errorMessage, response.mailboxVersion, response.serverTime, response.count, response.unreadCount, response.capacity, response.items, response.detail, response.itemQuantities, response.hasMore, response.nextOffset);
+        }
+        public static async UniTask<MailResponseModel> ClaimAllAsync(CancellationToken token)
+        {
+            var response = await SessionNetwork.Singleton.RequestAsync<ResMailClaimAll>(new ReqMailClaimAll(), Options("ClaimAll"), token);
+            if (response == null) throw new InvalidOperationException("邮件响应为空。");
+            return Map(response.status, response.errorMessage, response.mailboxVersion, response.serverTime, response.count, response.unreadCount, response.capacity, response.items, response.detail, response.itemQuantities, response.hasMore, response.nextOffset);
+        }
+        public static async UniTask<MailResponseModel> DeleteAsync(long id, CancellationToken token)
