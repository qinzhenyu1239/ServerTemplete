+using System;
+using System.Collections.Generic;
+using System.Collections.ObjectModel;
+using System.Linq;
+namespace TowerDefence.Networking.Integration
+{
+    public enum MailOperation { Summary, List, Read, Claim, ClaimAll, Delete, DeleteRead }
+    public sealed class MailAttachmentModel
+    {
+        public int SortOrder { get; }
+        public int ItemId { get; }
+        public long Quantity { get; }
+        public MailAttachmentModel(int order, int itemId, long quantity) { SortOrder = order; ItemId = itemId; Quantity = quantity; }
+    }
+    public sealed class MailItemModel
+    {
+        public long Id { get; }
+        public int MailType { get; }
+        public string Title { get; }
+        public string Body { get; }
+        public long SendTime { get; }
+        public long ExpireTime { get; }
+        public long ReadTime { get; }
+        public long ClaimTime { get; }
+        public IReadOnlyList<MailAttachmentModel> Attachments { get; }
+        public bool CanDelete => ReadTime > 0 && (MailType == 0 || ClaimTime > 0);
+        public bool CanClaim => MailType == 1 && ClaimTime == 0;
+        public bool Grey => MailType == 0 ? ReadTime > 0 : ClaimTime > 0;
+        public bool IsExpired(long now) => ExpireTime > 0 && ExpireTime <= now;
+        public MailItemModel(long id, int type, string title, string body, long sent, long expires, long read, long claimed, IEnumerable<MailAttachmentModel> attachments)
+        {
+            Id = id; MailType = type; Title = title ?? ""; Body = body ?? ""; SendTime = sent; ExpireTime = expires; ReadTime = read; ClaimTime = claimed;
+            Attachments = Array.AsReadOnly((attachments ?? Array.Empty<MailAttachmentModel>()).OrderBy(a => a.SortOrder).ToArray());
+        }
+        public MailItemModel WithContent(MailItemModel detail) => new MailItemModel(Id, MailType, Title, detail?.Body, SendTime, ExpireTime, ReadTime, ClaimTime, detail?.Attachments);
+    }
+    public sealed class MailSummaryModel
+    {
+        public long Version { get; }
+        public long ServerTime { get; }
+        public int Count { get; }
+        public int UnreadCount { get; }
+        public int Capacity { get; }
+        public MailSummaryModel(long version, long time, int count, int unread, int capacity)
+        { Version = version; ServerTime = time; Count = count; UnreadCount = unread; Capacity = capacity; }
+    }
+    public sealed class MailboxSnapshotModel
+    {
+        public static MailboxSnapshotModel Empty { get; } = new MailboxSnapshotModel(null, Array.Empty<MailItemModel>(), null, false, false);
+        public MailSummaryModel Summary { get; }
+        public IReadOnlyList<MailItemModel> Rows { get; }
+        public MailItemModel Detail { get; }
+        public bool HasList { get; }
+        public bool NeedsRefresh { get; }
+        public MailboxSnapshotModel(MailSummaryModel summary, IEnumerable<MailItemModel> rows, MailItemModel detail, bool hasList, bool needsRefresh)
+        { Summary = summary; Rows = Array.AsReadOnly(rows.ToArray()); Detail = detail; HasList = hasList; NeedsRefresh = needsRefresh; }
+    }
+    // Transport response mapped to immutable client models. No view or global state lives here.
+    public sealed class MailResponseModel
+    {
+        public int Status { get; }
+        public bool Success => Status == 1;
+        public string Error { get; }
+        public MailSummaryModel Summary { get; }
+        public IReadOnlyList<MailItemModel> Items { get; }
+        public MailItemModel Detail { get; }
+        public IReadOnlyDictionary<int, long> ItemQuantities { get; }
+        public bool HasMore { get; }
+        public int NextOffset { get; }
+        public MailResponseModel(int status, string error, MailSummaryModel summary, IEnumerable<MailItemModel> items, MailItemModel detail, IDictionary<int, long> quantities, bool more, int offset)
+        {
+            Status = status; Error = error; Summary = summary; Items = Array.AsReadOnly((items ?? Array.Empty<MailItemModel>()).ToArray()); Detail = detail;
+            ItemQuantities = new ReadOnlyDictionary<int, long>(new Dictionary<int, long>(quantities ?? new Dictionary<int, long>())); HasMore = more; NextOffset = offset;
+        }
+        public MailResponseModel WithFullList(IEnumerable<MailItemModel> items) => new MailResponseModel(Status, Error, Summary, items, Detail, new Dictionary<int,long>(ItemQuantities), false, NextOffset);
+    }
+    public sealed class MailOperationResultModel
+    {
+        public MailOperation Operation { get; }
+        public long MailId { get; }
+        public bool Success { get; }
+        public int Status { get; }
+        public string Error { get; }
+        public bool StateUncertain { get; }
+        public bool Reconciled { get; }
+        public MailOperationResultModel(MailOperation operation, long id, bool success, int status, string error, bool uncertain = false, bool reconciled = false)
+        { Operation = operation; MailId = id; Success = success; Status = status; Error = error; StateUncertain = uncertain; Reconciled = reconciled; }
+    }
+}
