+Copy-Item -LiteralPath (Join-Path $clientRoot 'Assets/Plugins/Google.Protobuf/Google.Protobuf.dll') -Destination "$isolatedRoot/Assets/Plugins"
+foreach ($assembly in @('UniTask','UniFramework.Event')) { Copy-Item -LiteralPath (Join-Path $clientRoot "Library/ScriptAssemblies/$assembly.dll") -Destination "$isolatedRoot/Assets/Plugins" }
+Copy-Item -LiteralPath (Join-Path $clientRoot 'Assets/typeface/荆南缘默体.ttf'), (Join-Path $clientRoot 'Assets/typeface/荆南缘默体.ttf.meta') -Destination "$isolatedRoot/Assets/typeface"
