+Set-Content -LiteralPath "$isolatedRoot/Assets/Rogue/Scripts/HotUpdate/MainInterface.cs" -Value 'public sealed class MainInterface : UnityEngine.MonoBehaviour { public UnityEngine.UI.Button SettingBtn, PlayerBasicInfoButton; }'
