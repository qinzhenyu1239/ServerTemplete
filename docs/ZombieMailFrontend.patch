+using System;
+using System.Threading;
+using System.Collections.Generic;
+using UniFramework.Event;
+namespace TowerDefence.Networking.Integration
+{
+    public sealed class MailRequestedEvent : IEventMessage
+    {
+        public readonly Guid RequestId;
+        public readonly MailOperation Operation;
+        public readonly long MailId;
+        public readonly CancellationToken Cancellation;
+        public readonly bool Reopen;
+        public MailRequestedEvent(Guid id, MailOperation operation, long mailId, CancellationToken token, bool reopen = false)
+        { RequestId = id; Operation = operation; MailId = mailId; Cancellation = token; Reopen = reopen; }
+    }
+    public sealed class MailViewChangedEvent : IEventMessage
+    {
+        public readonly Guid ViewId;
+        public readonly bool IsOpen;
+        public MailViewChangedEvent(Guid id, bool open) { ViewId = id; IsOpen = open; }
+    }
+    public sealed class MailSnapshotRequestedEvent : IEventMessage { }
+    public sealed class MailUpdatedEvent : IEventMessage
+    {
+        public readonly Guid RequestId;
+        public readonly MailboxSnapshotModel State;
+        public readonly bool IsBusy, IsSessionRefresh, IsCleared;
+        public readonly MailOperationResultModel Result;
+        public MailUpdatedEvent(Guid id, MailboxSnapshotModel state, bool busy, bool sessionRefresh = false, MailOperationResultModel result = null, bool cleared = false)
+        { RequestId = id; State = state; IsBusy = busy; IsSessionRefresh = sessionRefresh; Result = result; IsCleared = cleared; }
+    }
+    // Values are absolute server quantities, never local increments. Consumers can refresh their own inventory view.
+    public sealed class MailRewardsUpdatedEvent : IEventMessage
+    {
+        public readonly IReadOnlyDictionary<int,long> Quantities;
+        public readonly bool IsFullSnapshot;
+        public MailRewardsUpdatedEvent(IReadOnlyDictionary<int,long> quantities, bool full) { Quantities = quantities; IsFullSnapshot = full; }
+    }
+}
