+using TowerDefence.Networking.Integration;
+using UniFramework.Event;
+using UnityEngine;
+using UnityEngine.UI;
+namespace R.UI
+{
+    public sealed class UIMailUnreadBadge : MonoBehaviour
+    {
+        public Text Label;
+        private void OnEnable() { UniEvent.AddListener<MailUpdatedEvent>(OnUpdated); UniEvent.SendMessage(new MailSnapshotRequestedEvent()); }
+        private void OnDisable() => UniEvent.RemoveListener<MailUpdatedEvent>(OnUpdated);
+        private void OnUpdated(IEventMessage message)
+        { var summary = ((MailUpdatedEvent)message).State.Summary; Label.text = summary?.UnreadCount > 0 ? "邮件(" + summary.UnreadCount + ")" : "邮件"; }
+    }
+}
