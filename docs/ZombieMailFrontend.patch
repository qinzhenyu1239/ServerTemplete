+                case MailOperation.ClaimAll: return "一键领取完成。";
+                case MailOperation.Delete: return "邮件已删除。";
+                case MailOperation.DeleteRead: return "符合条件的已读邮件已删除。";
+                case MailOperation.Read: return "";
+                default: return "邮箱已更新。";
+            }
+        }
+        private void Apply()
+        {
+            SummaryText.text = _state.Summary == null ? "邮件 — / —    未读 —" : $"邮件 {_state.Summary.Count} / {_state.Summary.Capacity}    未读 {_state.Summary.UnreadCount}";
+            EmptyText.gameObject.SetActive(_state.Rows.Count == 0);
+            EmptyText.text = _state.Summary == null ? "连接游戏服后获取邮件" : _state.HasList ? "暂无邮件" : "打开或刷新以加载邮件";
+            for (int i = 0; i < _state.Rows.Count; i++)
+            {
+                if (i == _rows.Count) { var row = Instantiate(RowTemplate, MailContent, false); _rows.Add(row); }
+                _rows[i].gameObject.SetActive(true); _rows[i].Apply(_state.Rows[i], _selectedId, _busy, Select);
+            }
+            for (int i = _state.Rows.Count; i < _rows.Count; i++) _rows[i].gameObject.SetActive(false);
+            LayoutRebuilder.MarkLayoutForRebuild(MailContent);
+            if (!_state.Rows.Any(m => m.Id == _selectedId)) _selectedId = 0;
+            var detail = _state.Detail?.Id == _selectedId ? _state.Detail : null;
+            DetailTitleText.text = detail?.Title ?? "请选择一封邮件";
+            BodyText.text = detail == null ? "点击上方邮件查看正文和附件。" : FormatDetail(detail);
+            LayoutRebuilder.MarkLayoutForRebuild(BodyContent);
+            RefreshButton.interactable = !_busy;
+            bool writable = !_busy && !_state.NeedsRefresh;
+            ClaimButton.interactable = writable && detail?.CanClaim == true;
+            ClaimButton.GetComponentInChildren<Text>().text = detail?.ClaimTime > 0 ? "已领取" : "领取附件";
+            DeleteButton.interactable = writable && detail?.CanDelete == true;
+            ClaimAllButton.interactable = DeleteReadButton.interactable = writable && _state.Summary?.Count > 0;
+            ConfirmButton.interactable = !_busy;
+        }
+        private static string FormatDetail(MailItemModel detail)
+        {
+            var text = new StringBuilder();
+            text.Append("发送：").Append(FormatTime(detail.SendTime)).Append("\n到期：").Append(detail.ExpireTime == 0 ? "永久" : FormatTime(detail.ExpireTime));
+            text.Append("\n\n").Append(detail.Body);
+            if (detail.MailType == 1)
+            {
+                text.Append(detail.ClaimTime > 0 ? "\n\n附件（已领取）：" : "\n\n附件：");
+                foreach (var item in detail.Attachments) text.Append("\n道具 ").Append(item.ItemId).Append(" × ").Append(item.Quantity);
+            }
+            return text.ToString();
+        }
+        private static string FormatTime(long time)
+        { try { return time <= 0 ? "未知" : DateTimeOffset.FromUnixTimeSeconds(time).LocalDateTime.ToString("yyyy-MM-dd HH:mm"); } catch (ArgumentOutOfRangeException) { return "未知"; } }
+        private void CancelRequest() { _requestId = Guid.Empty; _request?.Cancel(); _request?.Dispose(); _request = null; }
+        private void Close() => UIMgr.Singleton.ConcealUI(nameof(UIMail));
+    }
+}
