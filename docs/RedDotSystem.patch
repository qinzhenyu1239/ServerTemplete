+using MiaoWu.Networking.RedDot;
+using UnityEngine;
+
+public sealed class RedDotBinding : MonoBehaviour
+{
+    [SerializeField] private int nodeId;
+    [SerializeField] private GameObject indicator;
+    private MiaoWu.Networking.RedDot.RedDotManager manager;
+    public void Bind(int id) { nodeId = id; Refresh(); }
+    private void OnEnable()
+    {
+        manager = MiaoWu.Networking.RedDot.RedDotManager.Singleton;
+        manager.Changed += Refresh;
+        Refresh();
+    }
+    private void OnDisable()
+    { if (manager != null) manager.Changed -= Refresh; manager = null; }
+    private void Refresh()
+    {
+        // Attach this component to the button, with a separate child as indicator.
+        if (indicator != null && indicator != gameObject)
+            indicator.SetActive(manager != null && manager.IsActive(nodeId));
+    }
+}
