+using MiaoWu.Networking.RedDot;
+using Xunit;
+
+public sealed class RedDotTreeTests
+{
+    [Fact]
+    public void ModelsContainDataWithoutOperationsOrEvents()
+    {
+        const System.Reflection.BindingFlags flags = System.Reflection.BindingFlags.Public |
+            System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.DeclaredOnly;
+        foreach (var type in new[] { typeof(RedDotTreeModel), typeof(RedDotNodeModel) })
+        {
+            Assert.Empty(type.GetEvents(flags));
+            Assert.DoesNotContain(type.GetMethods(flags), method => !method.IsSpecialName);
+        }
+    }
+
+    [Fact]
+    public void ManagerNotifiesAfterStateAndParentAggregationAreApplied()
+    {
+        var manager = new RedDotTreeManager();
+        int notifications = 0;
+        manager.Changed += () =>
+        {
+            notifications++;
+            Assert.Equal(manager.IsActive(1), manager.State.States[1]);
+        };
+        manager.Replace("a", 0, Nodes(), new Dictionary<int, bool> { [2] = true });
+        Assert.True(manager.State.States[1]);
+        manager.ApplyDelta("a", 1, new Dictionary<int, bool> { [2] = false });
+        Assert.False(manager.State.States[1]);
+        Assert.Equal(2, notifications);
+    }
+
+    private static RedDotNodeModel[] Nodes(bool enabled = true) => new[]
+    {
+        new RedDotNodeModel { Id = 1, ClearType = 0, Enabled = enabled },
+        new RedDotNodeModel { Id = 2, ParentId = 1, ClearType = 1, Enabled = true },
+        new RedDotNodeModel { Id = 3, ParentId = 1, ClearType = 1, Enabled = true }
+    };
+    [Fact]
+    public void ParentOnlyClearsAfterLastChildClears()
+    {
+        var tree = new RedDotTreeManager();
+        tree.Replace("a", 0, Nodes(), new Dictionary<int, bool> { [2] = true, [3] = true });
+        Assert.True(tree.IsActive(1));
+        Assert.True(tree.ApplyDelta("a", 1, new Dictionary<int, bool> { [2] = false }));
+        Assert.True(tree.IsActive(1));
+        Assert.True(tree.ApplyDelta("a", 2, new Dictionary<int, bool> { [3] = false }));
+        Assert.False(tree.IsActive(1));
+    }
+    [Fact]
+    public void DisabledSubtreeCannotContributeToParent()
+    {
+        var tree = new RedDotTreeManager();
+        tree.Replace("a", 0, Nodes(false), new Dictionary<int, bool> { [2] = true });
+        Assert.False(tree.IsActive(1)); Assert.False(tree.IsActive(2));
+    }
+    [Fact]
+    public void OldDeltaCannotOverwriteNewStateAndGapRequiresSnapshot()
+    {
+        var tree = new RedDotTreeManager();
+        tree.Replace("a", 5, Nodes(), new Dictionary<int, bool> { [2] = true });
+        Assert.True(tree.ApplyDelta("a", 4, new Dictionary<int, bool> { [2] = false }));
+        Assert.True(tree.IsActive(2));
+        Assert.False(tree.ApplyDelta("a", 7, new Dictionary<int, bool> { [2] = false }));
+        Assert.True(tree.IsActive(2));
+        Assert.False(tree.ApplyDelta("b", 6, new Dictionary<int, bool>()));
+    }
+    [Fact]
+    public void ReplacementRemovesOldNodesAndUsesNewParentRelationship()
+    {
+        var tree = new RedDotTreeManager();
+        tree.Replace("a", 2, Nodes(), new Dictionary<int, bool> { [2] = true, [3] = true });
+        var nodes = Nodes(); nodes[1].ParentId = 0;
+        tree.Replace("b", 0, nodes.Take(2), new Dictionary<int, bool> { [2] = true });
+        Assert.True(tree.IsActive(2)); Assert.False(tree.IsActive(1)); Assert.False(tree.IsActive(3));
+    }
+    [Fact]
+    public void InvalidTreeDoesNotPartiallyReplacePreviousSnapshot()
+    {
