+using System;
+using System.Threading;
+using Cysharp.Threading.Tasks;
+using Game.Datas.Messages;
+
+namespace MiaoWu.Networking.RedDot
+{
+    public static class RedDotNetwork
+    {
+        public static UniTask<ResRedDotInit> InitializeAsync(CancellationToken token) =>
+            SessionNetwork.Singleton.RequestAsync<ResRedDotInit>(new ReqRedDotInit(), Options("red-dot.init"), token);
+        public static UniTask<ResRedDotView> ViewAsync(int nodeId, long version, CancellationToken token) =>
+            SessionNetwork.Singleton.RequestAsync<ResRedDotView>(
+                new ReqRedDotView { nodeId = nodeId, tipVersion = version }, Options("red-dot.view." + nodeId), token);
+        private static NetworkRequestOptions Options(string key) => new()
+        { Timeout = TimeSpan.FromSeconds(10), OperationKey = key, DuplicatePolicy = DuplicateRequestPolicy.RejectNew };
+    }
+}
