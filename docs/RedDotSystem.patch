+using System.Collections.Generic;
+using MiaoWu.Networking.Recovery;
+
+namespace MiaoWu.Networking.RedDot
+{
+    [UnityEngine.Scripting.Preserve]
+    public sealed class RedDotRecoveryHandler : IReconnectRecoveryHandler
+    {
+        public string ModuleId => "red-dot";
+        public IEnumerable<RecoveryTask> CollectTasks(RecoveryContext context)
+        {
+            // Install push listeners before any initialization request is sent.
+            var manager = RedDotManager.Singleton;
+            yield return new RecoveryTask(RecoveryPhase.Refresh, 100, "red-dot.init", manager.InitializeAsync);
+        }
+    }
+}
