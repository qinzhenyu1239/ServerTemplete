+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using Cysharp.Threading.Tasks;
+using Game.Datas.Messages;
+using MiaoWu.Networking.Auth;
+using UniFramework.Event;
+
+namespace MiaoWu.Networking.RedDot
+{
+    public sealed class RedDotManager : Singleton_Mono<RedDotManager>
+    {
+        private readonly RedDotTreeManager treeManager = new();
+        public RedDotTreeModel Tree => treeManager.State;
+        public event Action Changed
+        { add => treeManager.Changed += value; remove => treeManager.Changed -= value; }
+        public bool IsActive(int nodeId) => treeManager.IsActive(nodeId);
+        public RedDotNodeModel GetNode(int nodeId) => treeManager.GetNode(nodeId);
+        private readonly SortedDictionary<long, NotifyRedDotChanged> pending = new();
+        private bool loading;
+        private int generation;
+        protected override bool Can_AutoInstance() => true;
+        protected override void OnInit()
+        {
+            gameObject.name = "ServerRedDotManager";
+            DontDestroyOnLoad(gameObject);
+            UniEvent.AddListener<NotifyRedDotChanged>(OnPush);
+            UniEvent.AddListener<UserLogoutStartedEvent>(OnReset);
+            UniEvent.AddListener<NetworkDisconnectedEvent>(OnReset);
+            UniEvent.AddListener<NetworkRecoveryStartedEvent>(OnReset);
+        }
+
+        private void OnReset(IEventMessage message)
+        { generation++; pending.Clear(); treeManager.Reset(); }
+
+        public async UniTask InitializeAsync(CancellationToken token = default)
+        {
+            if (loading) throw new InvalidOperationException("Red-dot initialization already running.");
+            using var scope = CancellationTokenSource.CreateLinkedTokenSource(token, UserLoginManager.Singleton.SessionCancellation);
+            token = scope.Token;
+            loading = true;
+            int expectedGeneration = generation;
+            treeManager.Reset();
+            try
+            {
+                for (int attempt = 0; attempt < 3; attempt++)
+                {
+                    var response = await RedDotNetwork.InitializeAsync(token);
+                    token.ThrowIfCancellationRequested();
+                    if (generation != expectedGeneration) throw new OperationCanceledException("Red-dot session changed.");
+                    if (response.status != (int)Respones.OK) throw new NetworkRequestException("Red-dot initialization failed: " + response.status);
+                    // Build and replay on a temporary tree; observers only see a complete, current snapshot.
+                    var next = new RedDotTreeManager();
+                    next.Replace(response.configVersion, response.stateVersion,
+                        response.nodes.Select(n => new RedDotNodeModel { Id = n.id, Name = n.name, ParentId = n.parentId,
+                            ClearType = n.clearType, Enabled = n.enabled, TipVersion = n.tipVersion }), Values(response.states));
+                    bool valid = true;
+                    var replayed = new Dictionary<int, bool>(Values(response.states));
+                    foreach (var push in pending.Values)
+                    {
+                        if (!next.ApplyDelta(push.configVersion, push.stateVersion, Values(push.states))) { valid = false; break; }
+                        if (push.stateVersion > response.stateVersion)
+                            foreach (var value in push.states) replayed[value.nodeId] = value.isActive;
+                    }
+                    pending.Clear();
+                    if (valid)
+                    {
+                        treeManager.Replace(next.ConfigVersion, next.StateVersion,
+                            response.nodes.Select(n => new RedDotNodeModel { Id = n.id, Name = n.name, ParentId = n.parentId,
+                                ClearType = n.clearType, Enabled = n.enabled, TipVersion = n.tipVersion }), replayed);
+                        return;
+                    }
+                }
+                throw new NetworkRequestException("Red-dot synchronization did not converge.");
+            }
+            finally { loading = false; }
+        }
+
+        public async UniTask MarkViewedAsync(int nodeId, long displayedVersion, CancellationToken token = default)
+        {
+            var node = GetNode(nodeId);
+            if (node == null || node.ClearType != 2 || !node.Enabled || !Tree.HasSnapshot ||
+                displayedVersion <= 0 || displayedVersion > node.TipVersion)
+                throw new ArgumentException("Only a configured view node can be cleared.");
+            int expectedGeneration = generation;
+            using var scope = CancellationTokenSource.CreateLinkedTokenSource(token, UserLoginManager.Singleton.SessionCancellation);
+            var result = await RedDotNetwork.ViewAsync(nodeId, displayedVersion, scope.Token);
+            scope.Token.ThrowIfCancellationRequested();
+            if (generation != expectedGeneration) throw new OperationCanceledException();
+            if (result.status != (int)Respones.OK) throw new NetworkRequestException("Red-dot view rejected: " + result.status);
+            if (!loading && !treeManager.ApplyFullState(result.configVersion, result.stateVersion, Values(result.states)))
+                await InitializeAsync(scope.Token);
+        }
+
+        private void OnPush(IEventMessage message)
+        {
+            if (!SessionNetwork.Singleton.IsGameAuthenticated) return;
+            var push = (NotifyRedDotChanged)message;
+            if (loading) { pending[push.stateVersion] = push; return; }
+            if (!treeManager.ApplyDelta(push.configVersion, push.stateVersion, Values(push.states)))
+                ResynchronizeAsync().Forget();
+        }
+        private async UniTask ResynchronizeAsync()
+        {
+            try { await InitializeAsync(); }
+            catch (Exception ex) { UnityEngine.Debug.LogWarning("Red-dot resynchronization failed: " + ex.Message); }
+        }
+        private static Dictionary<int, bool> Values(IEnumerable<RedDotStateMessage> states) =>
+            states.ToDictionary(s => s.nodeId, s => s.isActive);
+        protected override void OnDestroy()
+        {
+            UniEvent.RemoveListener<NotifyRedDotChanged>(OnPush);
+            UniEvent.RemoveListener<UserLogoutStartedEvent>(OnReset);
+            UniEvent.RemoveListener<NetworkDisconnectedEvent>(OnReset);
+            UniEvent.RemoveListener<NetworkRecoveryStartedEvent>(OnReset);
+            generation++; pending.Clear(); treeManager.Reset();
+            base.OnDestroy();
+        }
+    }
+}
