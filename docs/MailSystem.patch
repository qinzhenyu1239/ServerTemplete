+using UnityEngine;
+using UnityEngine.UI;
+
+namespace R.UI
+{
+    public sealed class UIMail : MonoBehaviour, IUIPanel
+    {
+        [Header("Actions")]
+        [SerializeField] private Button closeButton,refreshButton,claimButton,claimAllButton,deleteButton,deleteReadButton;
+        [Header("List / Detail")]
+        [SerializeField] private UIMailRow[] rowSlots=Array.Empty<UIMailRow>();
+        [SerializeField] private UIMailAttachment[] attachmentSlots=Array.Empty<UIMailAttachment>();
+        [SerializeField] private TMP_Text titleText,bodyText,sendTimeText,expiryText,countText,statusText,claimText;
+        [SerializeField] private GameObject detailPanel,rewardPanel;
+        [SerializeField] private UIMailLinkHandler linkHandler;
+        [Header("Confirmation")]
+        [SerializeField] private GameObject confirmationPanel;
+        [SerializeField] private TMP_Text confirmationText;
+        [SerializeField] private Button confirmButton,cancelButton;
+        private long selectedId;
+        private Action confirmAction;
+        private float nextTick;
+        public GameObject GameObject => gameObject;
+        public event Action<IReadOnlyList<MailDisplayModel>> RowsChanged;
+        public event Action<int> ItemDetailsRequested;
+        public event Action<string> LinkRequested;
+        public event Action<UIMailAttachment,int> AttachmentIconRequested;
+        public event Action<IReadOnlyList<Game.Datas.Messages.MailAttachmentMessage>,bool> AttachmentsChanged;
+        private MailManager Manager => MailManager.Singleton;
+        private void Awake()
+        {
+            closeButton?.onClick.AddListener(Close);refreshButton?.onClick.AddListener(Refresh);
+            claimButton?.onClick.AddListener(Claim);claimAllButton?.onClick.AddListener(ClaimAll);
+            deleteButton?.onClick.AddListener(Delete);deleteReadButton?.onClick.AddListener(DeleteRead);
+            confirmButton?.onClick.AddListener(Confirm);cancelButton?.onClick.AddListener(Cancel);
+            if(linkHandler!=null)linkHandler.LinkClicked=OnLink;
+        }
+        private void OnEnable() => UniEvent.AddListener<MailUpdatedEvent>(OnUpdated);
+        private void OnDisable() {UniEvent.RemoveListener<MailUpdatedEvent>(OnUpdated);Manager.CloseView();Cancel();}
+        private void OnDestroy()
+        {
+            closeButton?.onClick.RemoveListener(Close);refreshButton?.onClick.RemoveListener(Refresh);
+            claimButton?.onClick.RemoveListener(Claim);claimAllButton?.onClick.RemoveListener(ClaimAll);
+            deleteButton?.onClick.RemoveListener(Delete);deleteReadButton?.onClick.RemoveListener(DeleteRead);
+            confirmButton?.onClick.RemoveListener(Confirm);cancelButton?.onClick.RemoveListener(Cancel);
+            if(linkHandler!=null)linkHandler.LinkClicked=null;
+        }
+        public void OnSHow() {selectedId=0;Cancel();SetStatus("正在获取邮件…");LoadAsync(true).Forget();}
+        private void Close() {Manager.CloseView();UIMgr.Singleton.ConcealUI(nameof(UIMail));}
+        private void Refresh() => LoadAsync(false).Forget();
+        private async UniTaskVoid LoadAsync(bool reopen) {await Manager.LoadListAsync(reopen);}
+        public void Select(long id) {selectedId=id;ReadAsync(id).Forget();Apply();}
+        private async UniTaskVoid ReadAsync(long id) {await Manager.ReadAsync(id);}
+        private void Claim() {if(selectedId>0)ClaimAsync(selectedId).Forget();}
+        private async UniTaskVoid ClaimAsync(long id) {await Manager.ClaimAsync(id);}
+        private void ClaimAll() => ClaimAllAsync().Forget();
+        private async UniTaskVoid ClaimAllAsync() {await Manager.ClaimAllAsync();}
+        private void Delete() {if(selectedId>0)Ask("删除后无法恢复，确认删除此邮件吗？",()=>DeleteAsync(selectedId).Forget());}
+        private async UniTaskVoid DeleteAsync(long id) {var r=await Manager.DeleteAsync(id);if(r.Success){selectedId=0;Apply();}}
+        private void DeleteRead() => Ask("删除后无法恢复，确认是否删除所有已读邮件【不包含奖励未领取的邮件】？",()=>DeleteReadAsync().Forget());
+        private async UniTaskVoid DeleteReadAsync() {await Manager.DeleteReadAsync();}
+        private void Ask(string text,Action action)
+        {
+            if(confirmationPanel==null || confirmButton==null || cancelButton==null)
+            {SetStatus("请先绑定删除确认窗口及确认/取消按钮。");return;}
+            confirmAction=action;if(confirmationText!=null)confirmationText.text=text;confirmationPanel.SetActive(true);
+        }
+        private void Confirm() {var action=confirmAction;Cancel();action?.Invoke();}
+        private void Cancel() {confirmAction=null;confirmationPanel?.SetActive(false);}
+        private void OnLink(string target) => LinkRequested?.Invoke(target);
+        private void OnItem(int id) => ItemDetailsRequested?.Invoke(id);
+        private void OnUpdated(IEventMessage message)
+        {
+            var result=((MailUpdatedEvent)message).Result;
+            if(result.Operation is not ("Busy" or "Idle" or "Notice" or "Expiry" or "Reset"))
+                SetStatus(result.StateUncertain?"操作结果待确认，正在刷新邮箱和背包…":result.Success?"":result.Status==-142?"没有可领取的邮件":result.Status==-143?"奖励配置或数量异常，未发放任何奖励":result.Error ?? "邮件操作失败");
+            Apply();
+        }
+        private void Update() {if(Time.unscaledTime>=nextTick){nextTick=Time.unscaledTime+1;Apply();}}
+        private void Apply()
+        {
+            var state=Manager.State;long now=Manager.ServerNow;bool busy=Manager.IsBusy;
+            if(countText!=null)countText.text=state.Summary==null?"— / —":state.Summary.Count+" / "+state.Summary.Capacity;
+            RowsChanged?.Invoke(state.Rows);
+            for(int i=0;i<rowSlots.Length;i++)
+            {
+                if(rowSlots[i]==null)continue;bool show=i<state.Rows.Count;rowSlots[i].gameObject.SetActive(show);
+                if(show)rowSlots[i].Apply(state.Rows[i],selectedId,now,Select,busy);
+            }
+            var detail=state.Detail!=null && state.Detail.id==selectedId?state.Detail:null;
+            detailPanel?.SetActive(detail!=null);
+            if(detail!=null)
+            {
+                if(titleText!=null)titleText.text=detail.title;
+                if(bodyText!=null)bodyText.text=Regex.Replace(detail.body ?? "", "(<link=[^>]+>)", "$1<color=#4EA3FF>")
+                    .Replace("</link>","</color></link>");
+                if(sendTimeText!=null)sendTimeText.text=DateTimeOffset.FromUnixTimeSeconds(detail.sendTime).ToLocalTime().ToString("yyyy-MM-dd HH:mm");
+                if(expiryText!=null)expiryText.text=UIMailRow.FormatExpiry(detail.expireTime,now);
+            }
+            rewardPanel?.SetActive(detail!=null && detail.mailType==1);
+            var attachments=detail?.attachments.OrderBy(a=>a.sortOrder).ToArray();
+            AttachmentsChanged?.Invoke(attachments ?? Array.Empty<Game.Datas.Messages.MailAttachmentMessage>(),detail?.claimTime>0);
+            for(int i=0;i<attachmentSlots.Length;i++)
+            {
+                var slot=attachmentSlots[i];if(slot==null)continue;bool show=attachments!=null && i<attachments.Length;
+                slot.gameObject.SetActive(show);if(show){slot.Apply(attachments[i],detail.claimTime>0,OnItem);AttachmentIconRequested?.Invoke(slot,attachments[i].itemId);}
+            }
+            bool resource=detail!=null && detail.mailType==1;
+            if(claimButton!=null){claimButton.gameObject.SetActive(resource);claimButton.interactable=!busy && resource && detail.claimTime==0;}
+            if(claimText!=null)claimText.text=detail?.claimTime>0?"已领取":"领取";
+            if(deleteButton!=null){deleteButton.gameObject.SetActive(MailboxStateManager.CanDelete(detail));deleteButton.interactable=!busy;}
+            if(claimAllButton!=null)claimAllButton.interactable=!busy && state.Summary!=null;
+            if(deleteReadButton!=null)deleteReadButton.interactable=!busy && state.Summary!=null;
+            if(refreshButton!=null)refreshButton.interactable=!busy;
+        }
+        private void SetStatus(string text) {if(statusText!=null)statusText.text=text;}
+    }
+}
