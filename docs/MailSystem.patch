+                result.Items=snapshot.Items;result.Summary=snapshot.Summary;result.HasMore=false;
+                if(result.Detail!=null)
+                {
+                    var current=snapshot.Items.FirstOrDefault(m=>m.id==result.Detail.id);
+                    if(current==null)result.Detail=null;
+                    else{result.Detail.readTime=current.readTime;result.Detail.claimTime=current.claimTime;}
+                }
+            }
+            return result;
+        }
+    }
+}
