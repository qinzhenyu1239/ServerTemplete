+        }
+        public static async UniTask<MailOperationResultModel> DeleteAsync(long id, CancellationToken token=default)
+        {
+            var r=await SessionNetwork.Singleton.RequestAsync<ResMailDelete>(new ReqMailDelete {mailId=id},Options("Delete"),token);
+            return await CompleteAsync(new MailOperationResultModel {Operation="Delete",Status=r.status,Success=r.status==(int)Respones.OK,Error=r.errorMessage,
+                MailId=r.mailId,FullSnapshot=true,Detail=r.detail,Items=r.items,ItemQuantities=r.itemQuantities,
+                Summary=r.serverTime>0?new MailSummaryModel {Version=r.mailboxVersion,ServerTime=r.serverTime,
+                    Count=r.count,UnreadCount=r.unreadCount,Capacity=r.capacity}:null,HasMore=r.hasMore,NextOffset=r.nextOffset },token);
+        }
+        public static async UniTask<MailOperationResultModel> DeleteReadAsync(CancellationToken token=default)
+        {
+            var r=await SessionNetwork.Singleton.RequestAsync<ResMailDeleteRead>(new ReqMailDeleteRead(),Options("DeleteRead"),token);
+            return await CompleteAsync(new MailOperationResultModel {Operation="DeleteRead",Status=r.status,Success=r.status==(int)Respones.OK,Error=r.errorMessage,
+                MailId=r.mailId,FullSnapshot=true,Detail=r.detail,Items=r.items,ItemQuantities=r.itemQuantities,
+                Summary=r.serverTime>0?new MailSummaryModel {Version=r.mailboxVersion,ServerTime=r.serverTime,
+                    Count=r.count,UnreadCount=r.unreadCount,Capacity=r.capacity}:null,HasMore=r.hasMore,NextOffset=r.nextOffset },token);
+        }
+        public static async UniTask<MailOperationResultModel> ListAsync(CancellationToken token=default)
+        {
+            for(int attempt=0;attempt<3;attempt++)
+            {
+                var first=await ListPageAsync(0,token);
+                if(!first.Success)return first;
+                var entries=new List<MailEntryMessage>(first.Items);
+                var page=first;bool consistent=true;
+                while(page.HasMore)
