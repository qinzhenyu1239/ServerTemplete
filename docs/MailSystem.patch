+using System;
+using System.Threading;
+using Cysharp.Threading.Tasks;
+using Game.Datas.Messages;
+using MiaoWu.Networking.Auth;
+using UniFramework.Event;
+
+namespace MiaoWu.Networking.Mail
+{
+    public sealed class MailManager : Singleton_Mono<MailManager>
+    {
+        private readonly MailboxStateManager mailbox = new();
+        private readonly SemaphoreSlim requests = new(1, 1);
+        private int generation;
+        private bool busy;
+        private bool refreshPending;
+        private bool reconciling;
+        private double serverOffset;
+        private float nextTick;
+        public MailboxStateModel State => mailbox.State;
+        public bool IsBusy => busy;
+        public long ServerNow => (long)(DateTimeOffset.UtcNow.ToUnixTimeSeconds() + serverOffset);
+        protected override bool Can_AutoInstance() => true;
+        protected override void OnInit()
+        {
+            gameObject.name = nameof(MailManager); DontDestroyOnLoad(gameObject);
+            UniEvent.AddListener<NotifyMailChanged>(OnPush);
+            UniEvent.AddListener<UserLogoutStartedEvent>(OnLogout);
+            UniEvent.AddListener<NetworkDisconnectedEvent>(OnDisconnected);
+            UniEvent.AddListener<NetworkRecoveryStartedEvent>(OnDisconnected);
+        }
+        public void CloseView() => State.IsOpen = false;
+        public UniTask<MailOperationResultModel> LoadSummaryAsync(CancellationToken token = default) =>
+            RunAsync("Summary", 0, false, false, MailNetwork.SummaryAsync, token);
+        public UniTask<MailOperationResultModel> LoadListAsync(bool reopen = false, CancellationToken token = default)
+        { State.IsOpen = true; return RunAsync("List", 0, false, reopen, MailNetwork.ListAsync, token); }
+        public UniTask<MailOperationResultModel> ReadAsync(long id, CancellationToken token = default) =>
+            RunAsync("Read", id, false, false, t => MailNetwork.ReadAsync(id,t), token);
+        public UniTask<MailOperationResultModel> ClaimAsync(long id, CancellationToken token = default) =>
+            RunAsync("Claim", id, true, false, t => MailNetwork.ClaimAsync(id,t), token);
+        public UniTask<MailOperationResultModel> ClaimAllAsync(CancellationToken token = default) =>
+            RunAsync("ClaimAll", 0, true, false, MailNetwork.ClaimAllAsync, token);
+        public UniTask<MailOperationResultModel> DeleteAsync(long id, CancellationToken token = default) =>
+            RunAsync("Delete", id, true, false, t => MailNetwork.DeleteAsync(id,t), token);
+        public UniTask<MailOperationResultModel> DeleteReadAsync(CancellationToken token = default) =>
+            RunAsync("DeleteRead", 0, true, false, MailNetwork.DeleteReadAsync, token);
+
+        private async UniTask<MailOperationResultModel> RunAsync(string operation,long id,bool write,bool reopen,
+            Func<CancellationToken,UniTask<MailOperationResultModel>> request,CancellationToken token)
+        {
+            int expected = generation;
+            using var scope = CancellationTokenSource.CreateLinkedTokenSource(token,UserLoginManager.Singleton.SessionCancellation);
+            token = scope.Token;
+            bool acquired = false, rewardChanged = false, reconcile = false;
+            try
+            {
+                await requests.WaitAsync(token); acquired=true;
+                if (expected != generation) throw new OperationCanceledException();
+                if (!SessionNetwork.Singleton.IsGameAuthenticated) throw new InvalidOperationException("The game session is not authenticated.");
+                busy=true;
+                Publish(new MailOperationResultModel {Operation="Busy"});
+                var result=await request(token);
+                token.ThrowIfCancellationRequested();
+                if (expected!=generation) throw new OperationCanceledException();
+                result.Operation=operation; result.MailId=id;
+                if (result.Summary!=null) serverOffset=result.Summary.ServerTime-DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+                if (!mailbox.Apply(result,reopen) && result.Summary!=null) refreshPending=true;
+                if (result.Summary!=null && !result.FullSnapshot && operation!="Summary") refreshPending=true;
+                rewardChanged=result.ItemQuantities.Count>0;
+                Publish(result);
+                return result;
+            }
+            catch (Exception ex)
+            {
+                reconcile=write && expected==generation && ex is not OperationCanceledException;
+                var result=new MailOperationResultModel {Operation=operation,MailId=id,Error=ex.Message,
+                    Success=false,StateUncertain=write,Status=0};
+                if (expected==generation) Publish(result);
+                return result;
+            }
+            finally
+            {
+                if (acquired)
+                {
+                    busy=false; requests.Release();
+                    if (expected==generation)
+                    {
+                        Publish(new MailOperationResultModel {Operation="Idle"});
+                        if (rewardChanged || reconcile) RefreshInventoryAsync().Forget();
+                        if (refreshPending || reconcile) ReconcileAsync().Forget();
+                    }
+                }
+            }
+        }
+        private void OnPush(IEventMessage message)
+        {
+            if (!SessionNetwork.Singleton.IsGameAuthenticated) return;
+            var notice=(NotifyMailChanged)message;
+            bool gap=State.Summary==null || notice.mailboxVersion>State.Summary.Version+1;
+            if (!mailbox.ApplyNotice(notice)) return;
+            serverOffset=notice.serverTime-DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+            Publish(new MailOperationResultModel {Operation="Notice",Success=true,Summary=State.Summary});
+            if (State.IsOpen || gap) {refreshPending=true;if (!busy) ReconcileAsync().Forget();}
+        }
+        private async UniTask ReconcileAsync()
+        {
+            if (reconciling || !SessionNetwork.Singleton.IsGameAuthenticated) return;
+            reconciling=true;
+            try
+            {
+                // Only reads are repeated. Never replay a claim after an uncertain response.
+                for (int i=0;i<3;i++)
+                {
+                    refreshPending=false;
+                    var result=State.IsOpen?await LoadListAsync():await LoadSummaryAsync();
+                    if (!result.Success || !refreshPending) break;
+                }
+            }
+            finally {reconciling=false;}
+        }
+        private async UniTask RefreshInventoryAsync()
+        { try {await InventoryManager.Singleton.LoadAllAsync(UserLoginManager.Singleton.SessionCancellation);} catch(Exception ex){UnityEngine.Debug.LogWarning(ex.Message);} }
+        private void Update()
+        {
+            if (UnityEngine.Time.unscaledTime<nextTick) return;
+            nextTick=UnityEngine.Time.unscaledTime+1;
+            if (mailbox.Expire(ServerNow)) Publish(new MailOperationResultModel {Operation="Expiry",Success=true,Summary=State.Summary});
+        }
+        private void OnLogout(IEventMessage message) {generation++;refreshPending=false;mailbox.Reset();Publish(new MailOperationResultModel {Operation="Reset"});}
+        private void OnDisconnected(IEventMessage message) {generation++;refreshPending=false;mailbox.Reset(true);Publish(new MailOperationResultModel {Operation="Reset"});}
+        private static void Publish(MailOperationResultModel result) => UniEvent.SendMessage(new MailUpdatedEvent(result));
+        protected override void OnDestroy()
+        {
+            UniEvent.RemoveListener<NotifyMailChanged>(OnPush); UniEvent.RemoveListener<UserLogoutStartedEvent>(OnLogout);
+            UniEvent.RemoveListener<NetworkDisconnectedEvent>(OnDisconnected);UniEvent.RemoveListener<NetworkRecoveryStartedEvent>(OnDisconnected);
+            generation++;mailbox.Reset();base.OnDestroy();
+        }
+    }
+}
