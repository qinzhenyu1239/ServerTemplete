+            size += CodedOutputStream.ComputeTagSize(2) + CodedOutputStream.ComputeInt32Size(message.itemId);
+            size += CodedOutputStream.ComputeTagSize(3) + CodedOutputStream.ComputeInt64Size(message.quantity);
+            return size;
+        }
