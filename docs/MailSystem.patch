+using System.Linq;
+using Cysharp.Threading.Tasks;
+using Game.Datas.Messages;
+namespace MiaoWu.Networking.Mail
+{
+    public static class MailNetwork
+    {
+        private static NetworkRequestOptions Options(string key) => new NetworkRequestOptions
+        {Timeout=TimeSpan.FromSeconds(15),OperationKey="mail."+key,DuplicatePolicy=DuplicateRequestPolicy.RejectNew};
+        public static async UniTask<MailOperationResultModel> SummaryAsync(CancellationToken token=default)
+        {
+            var r=await SessionNetwork.Singleton.RequestAsync<ResMailSummary>(new ReqMailSummary(),Options("Summary"),token);
+            return await CompleteAsync(new MailOperationResultModel {Operation="Summary",Status=r.status,Success=r.status==(int)Respones.OK,Error=r.errorMessage,
+                MailId=r.mailId,FullSnapshot=false,Detail=r.detail,Items=r.items,ItemQuantities=r.itemQuantities,
+                Summary=r.serverTime>0?new MailSummaryModel {Version=r.mailboxVersion,ServerTime=r.serverTime,
+                    Count=r.count,UnreadCount=r.unreadCount,Capacity=r.capacity}:null,HasMore=r.hasMore,NextOffset=r.nextOffset },token);
+        }
+        private static async UniTask<MailOperationResultModel> ListPageAsync(int offset,CancellationToken token)
+        {
+            var r=await SessionNetwork.Singleton.RequestAsync<ResMailList>(new ReqMailList {offset=offset,pageSize=50},Options("List"),token);
+            return await CompleteAsync(new MailOperationResultModel {Operation="List",Status=r.status,Success=r.status==(int)Respones.OK,Error=r.errorMessage,
+                MailId=r.mailId,FullSnapshot=true,Detail=r.detail,Items=r.items,ItemQuantities=r.itemQuantities,
+                Summary=r.serverTime>0?new MailSummaryModel {Version=r.mailboxVersion,ServerTime=r.serverTime,
+                    Count=r.count,UnreadCount=r.unreadCount,Capacity=r.capacity}:null,HasMore=r.hasMore,NextOffset=r.nextOffset },token);
+        }
+        public static async UniTask<MailOperationResultModel> ReadAsync(long id, CancellationToken token=default)
+        {
+            var r=await SessionNetwork.Singleton.RequestAsync<ResMailRead>(new ReqMailRead {mailId=id},Options("Read"),token);
+            return await CompleteAsync(new MailOperationResultModel {Operation="Read",Status=r.status,Success=r.status==(int)Respones.OK,Error=r.errorMessage,
+                MailId=r.mailId,FullSnapshot=true,Detail=r.detail,Items=r.items,ItemQuantities=r.itemQuantities,
+                Summary=r.serverTime>0?new MailSummaryModel {Version=r.mailboxVersion,ServerTime=r.serverTime,
+                    Count=r.count,UnreadCount=r.unreadCount,Capacity=r.capacity}:null,HasMore=r.hasMore,NextOffset=r.nextOffset },token);
+        }
+        public static async UniTask<MailOperationResultModel> ClaimAsync(long id, CancellationToken token=default)
+        {
+            var r=await SessionNetwork.Singleton.RequestAsync<ResMailClaim>(new ReqMailClaim {mailId=id},Options("Claim"),token);
+            return await CompleteAsync(new MailOperationResultModel {Operation="Claim",Status=r.status,Success=r.status==(int)Respones.OK,Error=r.errorMessage,
+                MailId=r.mailId,FullSnapshot=true,Detail=r.detail,Items=r.items,ItemQuantities=r.itemQuantities,
+                Summary=r.serverTime>0?new MailSummaryModel {Version=r.mailboxVersion,ServerTime=r.serverTime,
+                    Count=r.count,UnreadCount=r.unreadCount,Capacity=r.capacity}:null,HasMore=r.hasMore,NextOffset=r.nextOffset },token);
+        }
