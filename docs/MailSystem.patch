+                    page=await ListPageAsync(page.NextOffset,token);
+                    if(!page.Success)return page;
+                    if(page.Summary.Version!=first.Summary.Version){consistent=false;break;}
+                    entries.AddRange(page.Items);
+                }
+                if(!consistent)continue;
+                first.Items=entries;first.HasMore=false;first.FullSnapshot=true;return first;
+            }
+            throw new NetworkRequestException("Mailbox changed during pagination; refresh again.");
+        }
+        private static async UniTask<MailOperationResultModel> CompleteAsync(MailOperationResultModel result,CancellationToken token)
+        {
+            if(result.Operation=="List" || !result.HasMore)return result;
+            var snapshot=await ListAsync(token);
+            result.FullSnapshot=snapshot.Success;
+            if(snapshot.Success)
