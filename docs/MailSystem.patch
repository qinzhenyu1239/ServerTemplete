+        [SerializeField] private Sprite unreadLetter, readLetter, unopenedGift, openedGift;
+        private long mailId;
+        private Action<long> select;
+        private void Awake() {button?.onClick.AddListener(Select);}
+        private void OnDestroy() {button?.onClick.RemoveListener(Select);}
+        private void Select() => select?.Invoke(mailId);
+        public void Apply(MailDisplayModel row,long selected,long now,Action<long> onSelect,bool busy=false)
+        {
+            if(button!=null)button.interactable=!busy;
+            var mail=row.Mail;mailId=mail.id;select=onSelect;
+            if(title!=null)title.text=mail.title;
+            if(expiry!=null)expiry.text=FormatExpiry(mail.expireTime,now);
+            newBadge?.SetActive(mail.readTime==0);resourceBadge?.SetActive(mail.mailType==1);
+            selectedBackground?.SetActive(selected==mail.id);
+            if(appearance!=null)appearance.alpha=row.Grey?0.5f:1f;
+            if(icon!=null)icon.sprite=mail.mailType==1?(mail.claimTime>0?openedGift:unopenedGift):(mail.readTime>0?readLetter:unreadLetter);
+        }
+        public static string FormatExpiry(long expires,long now)
+        {
+            if(expires==0)return "长期有效";
+            long seconds=Math.Max(0,expires-now);
+            if(seconds==0)return "已过期";
+            if(seconds>=86400)return (seconds/86400)+"天后过期";
+            long minutes=seconds/60;
+            return (minutes/60)+"小时"+(minutes%60)+"分后过期";
+        }
+    }
+}
