+        {
+            var r=await SessionNetwork.Singleton.RequestAsync<ResMailClaimAll>(new ReqMailClaimAll(),Options("ClaimAll"),token);
+            return await CompleteAsync(new MailOperationResultModel {Operation="ClaimAll",Status=r.status,Success=r.status==(int)Respones.OK,Error=r.errorMessage,
