+using MiaoWu.Networking.Mail;
+using Game.Datas.Messages;
+using Xunit;
+
+public sealed class MailboxTests
+{
+    private static MailEntryMessage Mail(long id,long read=0,long claim=0,int type=0,long expiry=0)=>new()
+    {id=id,title="mail"+id,readTime=read,claimTime=claim,mailType=type,expireTime=expiry};
+    private static MailOperationResultModel Snapshot(long version,params MailEntryMessage[] mails)=>new()
+    {FullSnapshot=true,Success=true,Summary=new MailSummaryModel{Version=version,ServerTime=100,Count=mails.Length,
+        UnreadCount=mails.Count(m=>m.readTime==0),Capacity=20},Items=mails};
+    [Fact]
+    public void OpeningCapturesOrderAndGreyUntilNextOpen()
+    {
+        var manager=new MailboxStateManager();manager.Apply(Snapshot(1,Mail(1),Mail(2)),true);
+        manager.Apply(Snapshot(2,Mail(2),Mail(1,read:50)));
+        Assert.Equal(new long[]{1,2},manager.State.Rows.Select(r=>r.Mail.id));
+        Assert.False(manager.State.Rows[0].Grey);Assert.Equal(50,manager.State.Rows[0].Mail.readTime);
+        manager.Apply(Snapshot(2,Mail(2),Mail(1,read:50)),true);
+        Assert.Equal(new long[]{2,1},manager.State.Rows.Select(r=>r.Mail.id));Assert.True(manager.State.Rows[1].Grey);
+    }
+    [Fact]
+    public void OldResponseCannotOverrideNewPush()
+    {
+        var manager=new MailboxStateManager();manager.Apply(Snapshot(1,Mail(1)));
+        manager.ApplyNotice(new NotifyMailChanged{mailboxVersion=3,count=0,unreadCount=0,serverTime=100,deletedIds=new(){1}});
+        Assert.False(manager.Apply(Snapshot(2,Mail(1))));Assert.Empty(manager.State.Rows);
+        Assert.False(manager.ApplyNotice(new NotifyMailChanged{mailboxVersion=2,count=1}));
+    }
+    [Fact]
+    public void ClaimUpdatesIconsAndDetailsWithoutChangingFrozenGrey()
+    {
+        var manager=new MailboxStateManager();var first=Snapshot(1,Mail(1,read:50,type:1));first.Detail=Mail(1,read:50,type:1);
+        first.Detail.attachments.Add(new MailAttachmentMessage{itemId=1,quantity=7});manager.Apply(first,true);
+        manager.Apply(Snapshot(2,Mail(1,read:50,claim:60,type:1)));
+        Assert.False(manager.State.Rows[0].Grey);Assert.Equal(60,manager.State.Detail.claimTime);
+        Assert.Single(manager.State.Detail.attachments);Assert.True(MailboxStateManager.CanDelete(manager.State.Detail));
+    }
+    [Fact]
+    public void ExpiryRemovesDetailAndUnreadCountWithoutInventingServerVersion()
+    {
+        var manager=new MailboxStateManager();var first=Snapshot(7,Mail(1,expiry:101),Mail(2));first.Detail=Mail(1,expiry:101);
+        manager.Apply(first,true);Assert.False(manager.Expire(100));Assert.True(manager.Expire(101));
+        Assert.Null(manager.State.Detail);Assert.Equal(1,manager.State.Summary.Count);Assert.Equal(1,manager.State.Summary.UnreadCount);
+        Assert.Equal(7,manager.State.Summary.Version);
+    }
+    [Fact]
+    public void ReconnectDropsOldAccountDataAndAcceptsNewSessionVersion()
+    {
+        var manager=new MailboxStateManager();manager.State.IsOpen=true;manager.Apply(Snapshot(90,Mail(1)));
+        manager.Reset(true);Assert.True(manager.State.IsOpen);Assert.Null(manager.State.Summary);
+        Assert.True(manager.Apply(Snapshot(0,Mail(2))));Assert.Equal(2,Assert.Single(manager.State.Rows).Mail.id);
+        manager.Reset();Assert.False(manager.State.IsOpen);
+    }
+    [Fact]
+    public void OrdinaryReadAndResourceClaimHaveSeparatePresentationRules()
+    {
+        Assert.True(MailboxStateManager.Grey(Mail(1,read:1)));
+        Assert.False(MailboxStateManager.Grey(Mail(2,read:1,type:1)));
+        Assert.True(MailboxStateManager.Grey(Mail(3,read:1,claim:2,type:1)));
+        Assert.False(MailboxStateManager.CanDelete(Mail(2,read:1,type:1)));
+    }
+    [Fact]
+    public void DisplayCopiesDoNotModifyTransportMessages()
+    {
+        var source=Mail(1);var manager=new MailboxStateManager();manager.Apply(Snapshot(1,source));
+        manager.State.Rows[0].Mail.readTime=50;Assert.Equal(0,source.readTime);
+    }
+    [Fact]
+    public void ModelsExposeNoBusinessMethodsOrEvents()
+    {
+        var types=new[]{typeof(MailSummaryModel),typeof(MailOperationResultModel),typeof(MailDisplayModel),typeof(MailboxStateModel)};
+        foreach(var type in types)
+        {
+            var flags=System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.DeclaredOnly;
+            Assert.Empty(type.GetMethods(flags));Assert.Empty(type.GetEvents(flags));
+        }
+    }
+}
