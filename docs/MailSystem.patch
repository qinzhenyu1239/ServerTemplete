+using Framework.Core.Net;
+using Framework.Core.Utils;
+using Game.Core.EntityMgr;
+using Game.Core.GM_MailMessage;
+using Game.Datas.Excels;
+using Game.Datas.Messages;
+using System;
+using System.Configuration;
+using System.Linq;
+namespace Game.Entries.Modules
+{
+    public sealed class MailModule
+    {
+        public static MailModule Instance { get; } = new();
+        public void Init()
+        {
+            if (!int.TryParse(ConfigurationManager.AppSettings["MailboxCapacity"], out int capacity) || capacity <= 0)
+                throw new ConfigurationErrorsException("Explicit positive MailboxCapacity is required for the game server.");
+            GM_MailMsgMgr.Instance.Configure(capacity, id => ExcelUtils.GetConfigData<Item>(id.ToString()) != null,
+                r => new NotifyMailChanged { mailboxVersion=r.MailboxVersion,serverTime=r.ServerTime,
+                    count=r.Count,unreadCount=r.UnreadCount,capacity=r.Capacity,
+                    addedIds=r.AddedIds.Distinct().ToList(),changedIds=r.ChangedIds.Distinct().ToList(),deletedIds=r.DeletedIds.Distinct().ToList() });
+        }
+        private static bool Current(IdSession session,long playerId) => playerId>0 && session!=null && session.playerId==playerId &&
+            ReferenceEquals(GM_EntityMgr.Instance.Get(playerId)?.uPlayer.s,session);
+        private static MailResult Run(IdSession session,long playerId,MailAction action,long id,bool hasRequest)
+        {
+            if (!Current(session,playerId)) return new MailResult { Status=MailStatus.NotAllowed,Error="Not authenticated." };
+            if (!hasRequest || (action is MailAction.Read or MailAction.Claim or MailAction.Delete) && id<=0)
+                return new MailResult { Status=MailStatus.Invalid };
+            return GM_MailMsgMgr.Instance.Execute(playerId,action,id);
+        }
+        public MailResult Send(MailSendCommand command) => !MailRules.ValidSend(command)
+            ? new MailResult { Status=MailStatus.Invalid } : GM_MailMsgMgr.Instance.Send(command);
+        private static int Code(MailResult r) => r.Error=="Not authenticated." ? (int)Respones.AccountIsNotLogin : r.Status switch
+        {
+            MailStatus.Success=>(int)Respones.OK, MailStatus.Invalid=>(int)Respones.InvalidParams,
+            MailStatus.NotFound=>(int)Respones.MailNotFound, MailStatus.NotAllowed=>(int)Respones.MailNotAllowed,
+            MailStatus.NoRewards=>(int)Respones.MailNoRewards, MailStatus.InvalidReward=>(int)Respones.MailInvalidReward,
+            MailStatus.SourceConflict=>(int)Respones.MailSourceConflict, _=>(int)Respones.SystemErr
+        };
+        private static MailEntryMessage Entry(MailData d,bool detail) => new MailEntryMessage
+        { id=d.Mail.id,mailType=d.Mail.mailType,title=d.Mail.title,body=detail?d.Mail.msgBody:null,
+            sendTime=d.Mail.sendTime,expireTime=d.Mail.expireTime,readTime=d.Mail.readTime,claimTime=d.Mail.claimTime,
+            attachments=detail?d.Attachments.Select(a=>new MailAttachmentMessage {sortOrder=a.sortOrder,itemId=a.itemId,quantity=a.quantity}).ToList()
