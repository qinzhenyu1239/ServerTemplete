+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Game.Datas.Messages;
+
+namespace MiaoWu.Networking.Mail
+{
+    /// <summary>Owns presentation snapshots and version checks; Models contain data only.</summary>
+    public sealed class MailboxStateManager
+    {
+        public MailboxStateModel State { get; } = new();
+        public void Reset(bool keepOpen = false)
+        { State.Summary = null; State.HasList = false; State.Rows.Clear(); State.Detail = null; if (!keepOpen) State.IsOpen = false; }
+        public bool Apply(MailOperationResultModel result, bool reopen = false)
+        {
+            if (result.Summary == null || State.Summary != null && result.Summary.Version < State.Summary.Version) return false;
+            State.Summary = result.Summary;
+            if (result.FullSnapshot)
+            {
+                var incoming = result.Items.Where(m => Valid(m, result.Summary.ServerTime)).ToDictionary(m => m.id);
+                var rows = new List<MailDisplayModel>();
+                if (!reopen && State.HasList)
+                    foreach (var row in State.Rows)
+                        if (incoming.TryGetValue(row.Mail.id, out var mail))
+                        { rows.Add(new MailDisplayModel { Mail = Copy(mail), Grey = row.Grey }); incoming.Remove(mail.id); }
+                foreach (var mail in result.Items.Where(m => incoming.ContainsKey(m.id)))
+                    rows.Add(new MailDisplayModel { Mail = Copy(mail), Grey = Grey(mail) });
+                State.Rows = rows; State.HasList = true;
+                if (State.Detail != null)
+                {
+                    var current = rows.FirstOrDefault(r => r.Mail.id == State.Detail.id)?.Mail;
+                    if (current == null) State.Detail = null;
+                    else { State.Detail.readTime = current.readTime; State.Detail.claimTime = current.claimTime; }
+                }
+            }
+            if (result.Detail != null) State.Detail = Copy(result.Detail);
+            return true;
+        }
+        public bool ApplyNotice(NotifyMailChanged notice)
+        {
+            if (State.Summary != null && notice.mailboxVersion <= State.Summary.Version) return false;
+            State.Summary = new MailSummaryModel { Version = notice.mailboxVersion, ServerTime = notice.serverTime,
+                Count = notice.count, UnreadCount = notice.unreadCount, Capacity = notice.capacity };
+            var deleted = new HashSet<long>(notice.deletedIds);
+            State.Rows.RemoveAll(r => deleted.Contains(r.Mail.id));
+            if (State.Detail != null && deleted.Contains(State.Detail.id)) State.Detail = null;
+            return true;
+        }
+        public bool Expire(long now)
+        {
+            var removed = State.Rows.Where(r => !Valid(r.Mail, now)).ToArray();
+            if (removed.Length == 0) return false;
+            var ids = new HashSet<long>(removed.Select(r => r.Mail.id));
+            State.Rows.RemoveAll(r => ids.Contains(r.Mail.id));
+            if (State.Detail != null && ids.Contains(State.Detail.id)) State.Detail = null;
+            if (State.Summary != null)
+            { State.Summary.Count = Math.Max(0, State.Summary.Count - removed.Length);
+                State.Summary.UnreadCount = Math.Max(0, State.Summary.UnreadCount - removed.Count(r => r.Mail.readTime == 0)); }
+            return true;
+        }
+        public static bool Valid(MailEntryMessage mail, long now) => mail.expireTime == 0 || mail.expireTime > now;
+        public static bool Grey(MailEntryMessage mail) => mail.mailType == 0 ? mail.readTime > 0 : mail.claimTime > 0;
+        public static bool CanDelete(MailEntryMessage mail) => mail != null && mail.readTime > 0 && (mail.mailType == 0 || mail.claimTime > 0);
+        private static MailEntryMessage Copy(MailEntryMessage m) => new MailEntryMessage
+        { id=m.id,mailType=m.mailType,title=m.title,body=m.body,sendTime=m.sendTime,expireTime=m.expireTime,
+            readTime=m.readTime,claimTime=m.claimTime,attachments=m.attachments.Select(a=>new MailAttachmentMessage
+                {sortOrder=a.sortOrder,itemId=a.itemId,quantity=a.quantity}).ToList() };
+    }
+}
