<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
	<add key = "ServerName" value = "DevServer"/>  
	<!-- Game / Login / Gateway / ServerZone -->
	<add key="ServerRole" value="Game"/>
	<add key="IsSsl" value="false"/>
	<add key="useRedis" value="false"/>
	<add key="LoginHttpPort" value="16091"/>
	<add key="ServerId" value="1"/>
	<add key="AuthAccessTokenMinutes" value="30"/>
	<add key="GameTicketSeconds" value="60"/>
	<add key="GameAuthenticationTimeoutSeconds" value="10"/>
	<add key="DatabaseCommandTimeoutSeconds" value="5"/>
	<!-- 登录服与游戏服必须一致；生产环境请使用 GAME_TICKET_HMAC_SECRET 环境变量覆盖 -->
	<add key="GameTicketHmacSecret" value="dev-only-change-this-hmac-secret-2026"/>
	<!-- 登录服主动通知单个游戏服使旧会话立即失效；跨主机部署时改为游戏服内网地址 -->
	<add key="GameSessionNotifyUrl" value="http://127.0.0.1:6090/Internal/InvalidateAccountSession"/>
	  
	<add key="HttpServerZonePort" value="16090"/>
	  
	  
	<add key="GatewayMode" value="false"/>
	<add key="GatewayTcpPort" value="6080"/>
	<add key="GatewayWsPort" value="6082"/>
	<add key="GatewayHttpPort" value="6090"/>  
	  
	<add key="port" value="6080"/>
	<add key="wsPort" value="6082"/>
	<add key="httpPort" value="6090"/>
	<add key="GwConnectPort" value="6091"/>
	<add key="HttpAuthAndPlayerWebsite" value ="http://127.0.0.1:6090/"/>
  </appSettings>

  <connectionStrings>
	<add name ="redisIpAddr" connectionString="127.0.0.1"/>
	<add name ="redisPort" connectionString="6379"/>
    <add name="connAuthUserStr" connectionString="Database=auth_10001;Data Source=127.0.0.1;Port=3306;User Id=root;Password=123456;Charset=utf8" />
    <add name="connGameDataStr" connectionString="Database=ugame_10001;Data Source=127.0.0.1;Port=3306;User Id=root;Password=123456;Charset=utf8" />
  </connectionStrings>

</configuration>
