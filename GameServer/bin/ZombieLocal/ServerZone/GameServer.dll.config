<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 邮箱容量（封），默认 100；必须为正整数。 -->
    <add key="MailboxCapacity" value="100" />
    <add key="ServerName" value="DevServer" />
    <!-- Game / Login / Gateway / ServerZone -->
    <add key="ServerRole" value="ServerZone" />
    <add key="IsSsl" value="false" />
    <add key="useRedis" value="false" />
    <add key="LoginHttpPort" value="16091" />
    <add key="ServerId" value="4" />
    <add key="AuthAccessTokenMinutes" value="30" />
    <add key="GameTicketSeconds" value="60" />
    <add key="GameAuthenticationTimeoutSeconds" value="10" />
    <add key="GameConnectionIdleTimeoutSeconds" value="60" />
    <add key="GameConnectionCheckIntervalSeconds" value="5" />
    <add key="DatabaseCommandTimeoutSeconds" value="5" />
    <!-- 登录服与游戏服必须一致；生产环境请使用 GAME_TICKET_HMAC_SECRET 环境变量覆盖 -->
    <add key="GameTicketHmacSecret" value="dev-only-change-this-hmac-secret-2026" />
    <add key="HttpServerZonePort" value="16090" />
    <add key="GatewayMode" value="false" />
    <add key="GatewayTcpPort" value="6080" />
    <add key="GatewayWsPort" value="6082" />
    <add key="GatewayHttpPort" value="6090" />
    <add key="port" value="7080" />
    <add key="wsPort" value="7082" />
    <add key="httpPort" value="6090" />
    <add key="GwConnectPort" value="7091" />
    <add key="HttpAuthAndPlayerWebsite" value="http://127.0.0.1:7090/" />
  </appSettings>
  <connectionStrings>
    <add name="redisIpAddr" connectionString="127.0.0.1" />
    <add name="redisPort" connectionString="6379" />
    <add name="connAuthUserStr" connectionString="Database=zombie_auth;Data Source=127.0.0.1;Port=3306;User Id=root;Password=123456;Charset=utf8" />
    <add name="connGameDataStr" connectionString="Database=zombie_game;Data Source=127.0.0.1;Port=3306;User Id=root;Password=123456;Charset=utf8" />
  </connectionStrings>
</configuration>